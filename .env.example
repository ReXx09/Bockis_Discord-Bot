# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=dein_discord_bot_token_hier
# Runtime / Logging
NODE_ENV=development
LOG_TIMEZONE=
STATUS_CHANNEL_ID=channel_id_fuer_die_status_nachricht
DISCORD_BOT_NAME=
DISCORD_PRESENCE_TEXT=Service Health
DISCORD_PRESENCE_ROTATE_MS=90000
# Optional: eigener Kanal für die öffentliche, gepinnte Bot-Befehls-Kachel
DISCORD_COMMANDS_CHANNEL_ID=
DISCORD_NOTIFICATION_CHANNEL=channel_id_fuer_aenderungs_alerts
DISCORD_STATUS_RENDER_MODE=auto
DISCORD_STATUS_WEBHOOK_URL=
DISCORD_STATUS_MESSAGE_TITLE=
DISCORD_STATUS_BUTTON_LABEL=Statusseite öffnen
DISCORD_WEBUI_BUTTON_LABEL=
CHANNEL_STATUS_INDICATOR=true
GUILD_ID=
SERVICE_GUILD_ID=
SERVICE_CATEGORY_NAME=📊 Service Status
SERVICE_CATEGORY_ID=
SERVICE_CHANNEL_NAME_MODE=strict_slug
SERVICE_CHANNEL_AUTO_CREATE=true
SERVICE_CHANNEL_AUTO_QUIET=true
SERVICE_CHANNEL_DEBUG=false
SERVICE_CHANNEL_DEBUG_FILTER=
# Optional: Monitorname=Discord-Kanal-ID, mehrere Zuordnungen mit ; trennen
SERVICE_CHANNEL_MAP=
MONITORED_SERVICES=
DISCORD_ENABLED_COMMANDS=status,uptime,refresh,help,triggerinfo,coinflip,dice,eightball,cleanup,translate
# Wird vom Dashboard aus der Textvorlage erstellt (Base64-kodiert)
DISCORD_COMMAND_TILE_TEMPLATE_B64=
DISCORD_COMMAND_TILE_SCALE=large
DISCORD_COMMAND_TILE_MODE=text

# ── OpenLigaDB ────────────────────────────────────────────────────────────────
DISCORD_OPENLIGADB_ENABLED=false
DISCORD_OPENLIGADB_CHANNEL_ID=
DISCORD_OPENLIGADB_FAVORITES=
DISCORD_OPENLIGADB_FEEDS=

# ── Auto-Reactions ────────────────────────────────────────────────────────────
DISCORD_AUTO_REACTION_ENABLED=false
DISCORD_AUTO_REACTION_EMOJIS=👍
DISCORD_AUTO_REACTION_CHANNEL_IDS=

# ── Auto-Reply ────────────────────────────────────────────────────────────────
DISCORD_AUTO_REPLY_ENABLED=false
DISCORD_AUTO_REPLY_MENTION_ONLY=false
DISCORD_AUTO_REPLY_CHANNEL_IDS=
DISCORD_AUTO_REPLY_COOLDOWN_MS=30000
DISCORD_AUTO_REPLY_RULES_FILE=./data/auto-replies.json
DISCORD_AUTO_REPLY_RESPONSE_MODE=list
DISCORD_AUTO_REPLY_CONNECTOR=Außerdem

# ── Willkommen ────────────────────────────────────────────────────────────────
DISCORD_WELCOME_ENABLED=false
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_WELCOME_MESSAGE_TEMPLATE=Willkommen {{user}}! Schön, dass du hier bist.

# ── GitHub Release-Watcher ───────────────────────────────────────────────────
DISCORD_GITHUB_WATCH_ENABLED=false
DISCORD_GITHUB_CHANNEL_ID=
# Optional: derselbe Release-Banner wird parallel in diesen Kanal gesendet
DISCORD_GITHUB_SECONDARY_CHANNEL_ID=
# owner/repo oder vollständige GitHub-URL; mehrere mit ; oder , trennen
DISCORD_GITHUB_REPOS=
# Wird vom Dashboard aus den Repo-Farben erstellt (Base64-kodiertes JSON)
DISCORD_GITHUB_REPO_COLORS_B64=
# Wird vom Dashboard aus Modus und Darstellung je Repository erstellt (Base64-kodiertes JSON)
DISCORD_GITHUB_REPO_SETTINGS_B64=
DISCORD_GITHUB_MODE=releases
DISCORD_GITHUB_POLL_INTERVAL_MS=300000
DISCORD_GITHUB_RELEASE_TEXT_COLOR=#e8eef9
DISCORD_GITHUB_POST_STYLE=highlights
DISCORD_GITHUB_HIGHLIGHTS_MAX=5
DISCORD_GITHUB_HIGHLIGHTS_AI=false
DISCORD_GITHUB_RELEASE_TEMPLATE="## 🚀 {{title}}\n\n{{body}}\n\n---\n📦 **Repository:** {{repo}}\n🏷️ **Tag:** {{tag}}\n📅 **Veröffentlicht:** {{date}}\n🔗 **Release:** {{url}}"
GITHUB_TOKEN=

# ── Discord Übersetzer (/translate) ──────────────────────────────────────────
DISCORD_TRANSLATE_ENABLED=false
DISCORD_TRANSLATE_DEFAULT_TARGET=de
DISCORD_TRANSLATE_DEFAULT_SOURCE=auto
DISCORD_TRANSLATE_PROVIDER=auto
DISCORD_TRANSLATE_API_URL=https://libretranslate.com/translate
DISCORD_TRANSLATE_API_KEY=
DISCORD_USE_DEEPL=false
DISCORD_DEEPL_API_KEY=
DISCORD_DEEPL_API_URL=https://api-free.deepl.com
DISCORD_TRANSLATE_ALLOWED_GUILD_IDS=
DISCORD_TRANSLATE_MAX_TEXT_LENGTH=1800

# ── Uptime Kuma ────────────────────────────────────────────────────────────────
UPTIME_KUMA_URL=http://uptime.deinedomain.de
UPTIME_KUMA_API_KEY=uk1_deinapikey
STATUS_PAGE_SLUG=dienste

# ── Timing ────────────────────────────────────────────────────────────────────
# Update-Intervall in Millisekunden (Standard: 300000 = 5 Minuten)
UPDATE_INTERVAL=300000

# ── Automatische Nachrichtenbereinigung ──────────────────────────────────────
MESSAGE_CLEANUP_ENABLED=false
MESSAGE_CLEANUP_INFO_ENABLED=true
MESSAGE_CLEANUP_CHANNEL_IDS=
MESSAGE_CLEANUP_MAX_MESSAGES=4
MESSAGE_CLEANUP_MAX_AGE_HOURS=12
MESSAGE_CLEANUP_ONLY_BOT_MESSAGES=true
MESSAGE_CLEANUP_INTERVAL_MS=300000

# ── Webserver ─────────────────────────────────────────────────────────────────
WEB_PORT=3000
# Passwort für das Web-Dashboard (leer lassen = kein Passwortschutz)
DASHBOARD_PASSWORD=

# ── Optionale WigiDash Hardware-Monitor Integration ────────────────────────────
# Nur aktivieren, wenn ein WigiDash/HWiNFO-Widget den Discord-Status abfragen soll.
# Für Bot, Dashboard und Monitoring wird diese API nicht benötigt.
WIGIDASH_API_ENABLED=false
# Host für WigiDash API: 127.0.0.1 = lokal nur, 0.0.0.0 = im Netzwerk erreichbar
WIGIDASH_API_HOST=127.0.0.1
# Port für den WigiDash Status-Endpunkt (Standard: 47900)
WIGIDASH_API_PORT=47900
# URL-Pfad des Status-Endpunkts
WIGIDASH_API_PATH=/status
# Discord-Benutzer-ID des zu verfolgenden Nutzers (leer = aktueller Bot-Owner)
WIGIDASH_TARGET_USER_ID=
# Optionale Guild-ID zum Filtern (leer = beliebiger Server)
WIGIDASH_TARGET_GUILD_ID=
# Nachrichtenanzeige für Zieluser und/oder Zielkanal aktivieren
WIGIDASH_MESSAGE_ENABLED=false
# Optionaler Kanalfilter für die Nachrichtenanzeige
WIGIDASH_TARGET_CHANNEL_ID=
# API-Schlüssel für Netzwerk-Zugriff (nur nötig wenn WIGIDASH_API_HOST=0.0.0.0)
WIGIDASH_API_KEY=

# ── Cloudflare Tunnel / Link Preview ──────────────────────────────────────────
# Öffentliche URL der Statusseite für Discord-Linkvorschau (z. B. https://status.deinedomain.de)
CLOUDFLARE_PUBLIC_URL=

# ── KI-Chat (OpenAI / ChatGPT) ────────────────────────────────────────────────
# KI-Chat aktivieren: Nutzer können den Bot per @Mention oder DM ansprechen
OPENAI_ENABLED=false
# OpenAI-kompatible API Base URL (OpenAI, Groq, OpenRouter, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI API-Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Modell: gpt-4o-mini (günstig), gpt-4o (besser), gpt-3.5-turbo (legacy)
OPENAI_MODEL=gpt-4o-mini
# Persönlichkeitsname des Bots im Chat
OPENAI_PERSONA_NAME=Bockis
# System-Prompt (leer = Standard-Persönlichkeit basierend auf OPENAI_PERSONA_NAME)
OPENAI_SYSTEM_PROMPT=
# Optionale Kanal-IDs wo KI-Chat aktiv ist, getrennt mit , oder ; (leer = überall)
OPENAI_CHANNEL_IDS=
# Maximale Antwort-Länge in Tokens (50–2000)
OPENAI_MAX_TOKENS=600
# Bot antwortet auch auf Direktnachrichten
OPENAI_ALLOW_DMS=true
# Auf den Bot-Rufnamen (z.B. Bob) auch ohne @Erwähnung reagieren
OPENAI_NAME_TRIGGER_ENABLED=true
# Maximale Anfragen pro Nutzer pro Minute (Schutz vor Missbrauch)
OPENAI_RATE_LIMIT_PER_MINUTE=5

# ── Datenbank ─────────────────────────────────────────────────────────────────
DB_DIALECT=sqlite
DB_STORAGE=./data/status.db
