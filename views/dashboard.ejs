  // ── Config laden ─────────────────────────────────────
  const DEFAULT_GITHUB_RELEASE_COLOR = '#1f6feb';

  function normalizeGitHubRepositoryForColors(value) {
    let repository = String(value || '').trim();
    if (!repository) return '';
    try {
      const url = new URL(repository);
      if (!['github.com', 'www.github.com'].includes(url.hostname.toLowerCase())) return '';
      repository = url.pathname;
    } catch {
      repository = repository.replace(/^https?:\/\/(?:www\.)?github\.com\//i, '');
    }
    repository = repository.replace(/^\/+|\/+$/g, '').replace(/\.git$/i, '').toLowerCase();
    return /^[a-z0-9_.-]+\/[a-z0-9_.-]+$/.test(repository) ? repository : '';
  }

  function readGitHubRepositoryColors() {
    try {
      const parsed = JSON.parse(document.getElementById('cfgGithubRepoColors')?.value || '{}');
      if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return {};
      return Object.fromEntries(Object.entries(parsed).flatMap(([repository, color]) => {
        const normalizedRepository = normalizeGitHubRepositoryForColors(repository);
        const normalizedColor = String(color || '').trim().toLowerCase();
        return normalizedRepository && /^#[0-9a-f]{6}$/.test(normalizedColor)
          ? [[normalizedRepository, normalizedColor]]
          : [];
      }));
    } catch {
      return {};
    }
  }

  function readGitHubRepositorySettings() {
    try {
      const parsed = JSON.parse(document.getElementById('cfgGithubRepoSettings')?.value || '{}');
      if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return {};
      return Object.fromEntries(Object.entries(parsed).flatMap(([repository, settings]) => {
        const normalizedRepository = normalizeGitHubRepositoryForColors(repository);
        if (!normalizedRepository || !settings || typeof settings !== 'object' || Array.isArray(settings)) return [];
        const mode = ['releases', 'commits', 'both'].includes(settings.mode) ? settings.mode : 'releases';
        const postStyle = ['highlights', 'image'].includes(settings.postStyle) ? settings.postStyle : 'highlights';
        return [[normalizedRepository, { mode, postStyle }]];
      }));
    } catch {
      return {};
    }
  }

  function renderGitHubRepositoryColorRows(repositoryValues) {
    const container = document.getElementById('cfgGithubRepoColorRows');
    if (!container) return;
    const repositories = repositoryValues || String(document.getElementById('cfgGithubRepos')?.value || '')
      .split(/[;,\s]+/).map(value => value.trim()).filter(Boolean);
    const colors = readGitHubRepositoryColors();
    const settings = readGitHubRepositorySettings();
    const defaultMode = document.getElementById('cfgGithubMode')?.value || 'releases';
    const defaultPostStyle = document.getElementById('cfgGithubPostStyle')?.value || 'highlights';
    container.replaceChildren();
    if (!repositories.length) {
      const emptyRow = document.createElement('tr');
      const emptyCell = document.createElement('td');
      emptyCell.colSpan = 5;
      emptyCell.className = 'muted';
      emptyCell.style.cssText = 'padding:12px 10px;text-align:center';
      emptyCell.textContent = 'Noch keine Repositories hinzugefügt.';
      emptyRow.appendChild(emptyCell);
      container.appendChild(emptyRow);
      return;
    }

    repositories.forEach((value, index) => {
      const repository = normalizeGitHubRepositoryForColors(value);
      const row = document.createElement('tr');
      row.style.borderTop = index ? '1px solid var(--border)' : '';
      const nameCell = document.createElement('td');
      nameCell.style.cssText = 'padding:6px 8px';
      const name = document.createElement('input');
      name.className = 'cfg-input';
      name.type = 'text';
      name.autocomplete = 'off';
      name.maxLength = 200;
      name.placeholder = 'owner/repo oder GitHub-URL';
      name.value = value;
      name.dataset.githubRepoValue = '1';
      name.style.width = '100%';
      nameCell.appendChild(name);
      const modeCell = document.createElement('td');
      modeCell.style.cssText = 'padding:6px 8px';
      const mode = document.createElement('select');
      mode.className = 'cfg-input';
      mode.dataset.repoMode = '1';
      mode.style.width = '100%';
      [['releases', 'Nur Releases'], ['commits', 'Nur Commits'], ['both', 'Releases & Commits']].forEach(([value, label]) => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = label;
        mode.appendChild(option);
      });
      mode.value = settings[repository]?.mode || defaultMode;
      mode.addEventListener('change', syncGitHubRepositorySettings);
      modeCell.appendChild(mode);
      const styleCell = document.createElement('td');
      styleCell.style.cssText = 'padding:6px 8px';
      const postStyle = document.createElement('select');
      postStyle.className = 'cfg-input';
      postStyle.dataset.repoPostStyle = '1';
      postStyle.style.width = '100%';
      [['highlights', 'Kompakte Highlights'], ['image', 'Klassische Release-Notes']].forEach(([value, label]) => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = label;
        postStyle.appendChild(option);
      });
      postStyle.value = settings[repository]?.postStyle || defaultPostStyle;
      postStyle.addEventListener('change', syncGitHubRepositorySettings);
      styleCell.appendChild(postStyle);
      const colorCell = document.createElement('td');
      colorCell.style.cssText = 'padding:6px 8px;text-align:center';
      const color = document.createElement('input');
      color.type = 'color';
      color.value = colors[repository] || DEFAULT_GITHUB_RELEASE_COLOR;
      color.disabled = !repository;
      color.dataset.repoColor = '1';
      color.setAttribute('aria-label', `Release-Farbe für ${repository}`);
      color.title = `Release-Farbe für ${repository}`;
      color.style.cssText = 'width:42px;height:30px;padding:2px;border:1px solid var(--border);border-radius:4px;background:transparent;cursor:pointer';
      color.addEventListener('input', syncGitHubRepositoryColors);
      color.addEventListener('change', syncGitHubRepositoryColors);
      colorCell.appendChild(color);
      const actionCell = document.createElement('td');
      actionCell.style.cssText = 'padding:6px 8px;text-align:right';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn';
      remove.textContent = '✕';
      remove.title = `Repository ${value} entfernen`;
      remove.setAttribute('aria-label', `Repository ${value} entfernen`);
      remove.addEventListener('click', () => {
        row.remove();
        syncGitHubRepositoryRows();
        syncGitHubRepositorySettings();
        syncGitHubRepositoryColors();
        if (!container.querySelector('[data-github-repo-value]')) renderGitHubRepositoryColorRows();
      });
      actionCell.appendChild(remove);
      name.addEventListener('input', () => {
        const normalized = normalizeGitHubRepositoryForColors(name.value);
        color.disabled = !normalized;
        color.setAttribute('aria-label', `Release-Farbe für ${normalized || 'Repository'}`);
        color.title = `Release-Farbe für ${normalized || 'Repository'}`;
        syncGitHubRepositoryRows();
      });
      name.addEventListener('change', () => {
        const normalized = normalizeGitHubRepositoryForColors(name.value);
        color.value = colors[normalized] || DEFAULT_GITHUB_RELEASE_COLOR;
        mode.value = settings[normalized]?.mode || defaultMode;
        postStyle.value = settings[normalized]?.postStyle || defaultPostStyle;
        mode.disabled = !normalized;
        postStyle.disabled = !normalized;
        syncGitHubRepositorySettings();
        syncGitHubRepositoryColors();
      });
      mode.disabled = !repository;
      postStyle.disabled = !repository;
      row.append(nameCell, modeCell, styleCell, colorCell, actionCell);
      container.appendChild(row);
    });
  }

  function syncGitHubRepositoryRows() {
    const hidden = document.getElementById('cfgGithubRepos');
    const container = document.getElementById('cfgGithubRepoColorRows');
    if (!hidden || !container) return;
    const values = Array.from(container.querySelectorAll('[data-github-repo-value]'))
      .map(input => String(input.value || '').trim()).filter(Boolean);
    const serialized = [...new Set(values)].join(';');
    if (hidden.value !== serialized) {
      hidden.value = serialized;
      hidden.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  function syncGitHubRepositorySettings() {
    const hidden = document.getElementById('cfgGithubRepoSettings');
    const container = document.getElementById('cfgGithubRepoColorRows');
    if (!hidden || !container) return;
    const settings = {};
    container.querySelectorAll('tr').forEach(row => {
      const repository = normalizeGitHubRepositoryForColors(row.querySelector('[data-github-repo-value]')?.value);
      if (!repository) return;
      settings[repository] = {
        mode: row.querySelector('[data-repo-mode]')?.value || 'releases',
        postStyle: row.querySelector('[data-repo-post-style]')?.value || 'highlights'
      };
    });
    const serialized = JSON.stringify(settings);
    if (hidden.value !== serialized) {
      hidden.value = serialized;
      hidden.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  function addGitHubRepositoryRow() {
    const hidden = document.getElementById('cfgGithubRepos');
    const currentRows = Array.from(document.querySelectorAll('#cfgGithubRepoColorRows [data-github-repo-value]'))
      .map(input => String(input.value || '').trim()).filter(Boolean);
    currentRows.push('');
    renderGitHubRepositoryColorRows(currentRows);
    const inputs = document.querySelectorAll('#cfgGithubRepoColorRows [data-github-repo-value]');
    inputs[inputs.length - 1]?.focus();
  }

  function syncGitHubRepositoryColors() {
    const hidden = document.getElementById('cfgGithubRepoColors');
    const container = document.getElementById('cfgGithubRepoColorRows');
    if (!hidden || !container) return;
    const colors = {};
    container.querySelectorAll('tr').forEach(row => {
      const repository = normalizeGitHubRepositoryForColors(row.querySelector('[data-github-repo-value]')?.value);
      const color = String(row.querySelector('[data-repo-color]')?.value || DEFAULT_GITHUB_RELEASE_COLOR).toLowerCase();
      if (repository && color !== DEFAULT_GITHUB_RELEASE_COLOR) colors[repository] = color;
    });
    const serialized = JSON.stringify(colors);
    if (hidden.value !== serialized) {
      hidden.value = serialized;
      hidden.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  const DEFAULT_GITHUB_RELEASE_TEMPLATE = '🚀 {{title}}\n🏷️ {{tag}} · {{repo}}\n📅 {{date}} · von {{author}}\n\n{{body}}\n\n🔗 {{url}}';
  let githubReleasePreviewData = null;
  let githubReleasePreviewRepo = '';
  let githubReleasePreviewRequest = 0;
  let githubReleasePreviewTimer = null;
  let githubReleaseGraphicPreviewRequest = 0;
  let githubReleaseGraphicPreviewTimer = null;
  let githubReleaseGraphicPreviewUrl = '';

  function getGitHubPreviewRepositories() {
    return [...new Set(String(document.getElementById('cfgGithubRepos')?.value || '')
      .split(/[;,\s]+/).map(normalizeGitHubRepositoryForColors).filter(Boolean))];
  }

  function updateGitHubReleasePreviewRepositories() {
    const select = document.getElementById('githubReleasePreviewRepoSelect');
    if (!select) return;
    const repositories = getGitHubPreviewRepositories();
    const selected = normalizeGitHubRepositoryForColors(select.value);
    select.replaceChildren();
    repositories.forEach(repository => {
      const option = document.createElement('option');
      option.value = repository;
      option.textContent = repository;
      select.appendChild(option);
    });
    select.value = repositories.includes(selected) ? selected : (repositories[0] || '');
    select.disabled = repositories.length === 0;
  }

  function renderGitHubReleaseBannerPreview() {
    const preview = document.getElementById('githubReleaseBannerPreview');
    const banner = githubReleasePreviewData?.banner;
    if (!preview || !banner) {
      if (preview) preview.hidden = true;
      return;
    }
    preview.hidden = false;
    document.getElementById('githubReleaseBannerAccent').style.backgroundColor = `#${Number(banner.color).toString(16).padStart(6, '0')}`;
    const title = document.getElementById('githubReleaseBannerTitle');
    title.textContent = banner.title || '';
    const url = String(banner.url || '');
    try {
      const parsedUrl = new URL(url);
      if (parsedUrl.protocol === 'https:' && parsedUrl.hostname === 'github.com') title.href = parsedUrl.href;
      else title.removeAttribute('href');
    } catch {
      title.removeAttribute('href');
    }
    document.getElementById('githubReleaseBannerHighlight').textContent = banner.description || '';
    document.getElementById('githubReleaseBannerFooter').textContent = banner.footer?.text || '';
    const time = document.getElementById('githubReleaseBannerTime');
    time.textContent = banner.timestamp ? new Date(banner.timestamp).toLocaleString('de-DE') : '';
  }

  function renderGitHubReleaseTextPreview() {
    const templateEditor = document.getElementById('cfgGithubReleaseTemplate');
    const editor = document.getElementById('githubReleaseMessageEditor');
    const preview = document.getElementById('githubReleaseTextPreview');
    const status = document.getElementById('githubReleaseTextPreviewStatus');
    const repoLabel = document.getElementById('githubReleaseTextPreviewRepo');
    if (!templateEditor || !editor || !preview || !status) return;
    if (!githubReleasePreviewData) return;

    if (editor.dataset.userEdited !== 'true') {
      const template = templateEditor.value || DEFAULT_GITHUB_RELEASE_TEMPLATE;
      editor.value = template.replace(/\{\{(title|tag|repo|date|url|body|author)\}\}/g, (match, key) =>
        String(githubReleasePreviewData[key] ?? match));
    }
    const text = editor.value;
    if (repoLabel) repoLabel.textContent = githubReleasePreviewData.repo;
    renderGitHubReleaseBannerPreview();
    status.textContent = `${text.length} Zeichen · Grafik wird aktualisiert…`;
    const requestId = ++githubReleaseGraphicPreviewRequest;
    clearTimeout(githubReleaseGraphicPreviewTimer);
    githubReleaseGraphicPreviewTimer = setTimeout(async () => {
      try {
        const response = await fetch('/api/previews/github-release-graphic.png', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            repository: githubReleasePreviewData.repo,
            text,
            textColor: document.getElementById('cfgGithubReleaseTextColor')?.value || '#e8eef9'
          })
        });
        if (!response.ok) {
          const result = await response.json();
          throw new Error(result.error || 'Grafikvorschau konnte nicht erstellt werden');
        }
        const image = await response.blob();
        if (requestId !== githubReleaseGraphicPreviewRequest) return;
        if (githubReleaseGraphicPreviewUrl) URL.revokeObjectURL(githubReleaseGraphicPreviewUrl);
        githubReleaseGraphicPreviewUrl = URL.createObjectURL(image);
        preview.src = githubReleaseGraphicPreviewUrl;
        status.textContent = `${text.length} Zeichen`;
      } catch (error) {
        if (requestId !== githubReleaseGraphicPreviewRequest) return;
        preview.removeAttribute('src');
        status.textContent = error.message;
      }
    }, 180);
  }

  async function loadGitHubReleaseTextPreview(force = false) {
    updateGitHubReleasePreviewRepositories();
    const repositories = getGitHubPreviewRepositories();
    const selectedRepository = normalizeGitHubRepositoryForColors(document.getElementById('githubReleasePreviewRepoSelect')?.value);
    const repository = repositories.includes(selectedRepository) ? selectedRepository : repositories[0];
    const preview = document.getElementById('githubReleaseTextPreview');
    const status = document.getElementById('githubReleaseTextPreviewStatus');
    const repoLabel = document.getElementById('githubReleaseTextPreviewRepo');
    const editor = document.getElementById('githubReleaseMessageEditor');
    if (!repository) {
      githubReleasePreviewData = null;
      if (preview) preview.removeAttribute('src');
      if (editor) { editor.value = ''; editor.dataset.userEdited = 'false'; }
      if (status) status.textContent = 'Bitte im GitHub-Watcher zuerst ein Repository als owner/repo eintragen.';
      if (repoLabel) repoLabel.textContent = '';
      return false;
    }

    if (force || repository !== githubReleasePreviewRepo || !githubReleasePreviewData) {
      const requestId = ++githubReleasePreviewRequest;
      if (status) status.textContent = `Lade letzten Release von ${repository}…`;
      try {
        const response = await fetch(`/api/previews/github-release.json?repo=${encodeURIComponent(repository)}&v=${Date.now()}`);
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Release-Vorschau konnte nicht geladen werden');
        if (requestId !== githubReleasePreviewRequest) return false;
        githubReleasePreviewData = result.release;
        if (repository !== githubReleasePreviewRepo && editor) editor.dataset.userEdited = 'false';
        githubReleasePreviewRepo = repository;
      } catch (error) {
        if (requestId !== githubReleasePreviewRequest) return false;
        githubReleasePreviewData = null;
        if (preview) preview.removeAttribute('src');
        if (editor) { editor.value = ''; editor.dataset.userEdited = 'false'; }
        if (status) status.textContent = error.message;
        if (repoLabel) repoLabel.textContent = '';
        return false;
      }
    }

    renderGitHubReleaseTextPreview();
    return true;
  }

  function insertGitHubReleaseTemplateText(text) {
    const editor = document.getElementById('cfgGithubReleaseTemplate');
    if (!editor) return;
    editor.focus();
    editor.setRangeText(text, editor.selectionStart, editor.selectionEnd, 'end');
    editor.dispatchEvent(new Event('input', { bubbles: true }));
  }

  async function triggerGitHubWatcherCheck(btn) {
    const status = document.getElementById('githubPreviewStatus');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ Lade & sende…'; }
    if (status) status.textContent = 'Lade aktuellen Release und sende Vorschautext…';
    try {
      const loaded = await loadGitHubReleaseTextPreview(true);
      if (!loaded) {
        const previewStatus = document.getElementById('githubReleaseTextPreviewStatus');
        throw new Error(previewStatus?.textContent || 'Release-Vorschau konnte nicht geladen werden');
      }
      const repository = normalizeGitHubRepositoryForColors(document.getElementById('githubReleasePreviewRepoSelect')?.value);
      const text = document.getElementById('githubReleaseMessageEditor')?.value || '';
      const res = await fetch('/api/github-watcher/send-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          repository,
          text,
          textColor: document.getElementById('cfgGithubReleaseTextColor')?.value || '#e8eef9'
        })
      });
      const data = await res.json();
      if (data.ok) {
        if (status) status.textContent = '✅ ' + (data.message || 'Vorschautext gesendet');
      } else {
        if (status) status.textContent = '❌ ' + (data.error || 'Fehler');
      }
    } catch (err) {
      if (status) status.textContent = '❌ ' + err.message;
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = '🔄 Jetzt prüfen & senden'; }
    }
  }

  let commandTilePreviewRequest = 0;
  let commandTilePreviewTimer = null;
  async function requestCommandTilePreviewText(template) {
    const response = await fetch('/api/previews/commands.txt', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ template })
    });
    const result = await response.json();
    if (!response.ok || !result.ok) throw new Error(result.error || 'Vorschau konnte nicht erstellt werden');
    return String(result.text);
  }

  async function updateCommandTileEditorPreview() {
    const editor = document.getElementById('cfgCommandTileTemplate');
    const preview = document.getElementById('cfgCommandTilePreview');
    const status = document.getElementById('cfgCommandTilePreviewStatus');
    if (!editor || !preview || !status) return;
    const requestId = ++commandTilePreviewRequest;
    status.textContent = 'Vorschau wird aktualisiert…';
    try {
      const text = await requestCommandTilePreviewText(editor.value);
      if (requestId !== commandTilePreviewRequest) return;
      preview.textContent = text;
      status.textContent = `${text.length} / 2000 Zeichen`;
    } catch (err) {
      if (requestId !== commandTilePreviewRequest) return;
      preview.textContent = '';
      status.textContent = err.message;
    }
