  function insertCommandTileTemplateText(text) {
    const editor = document.getElementById('cfgCommandTileTemplate');
    if (!editor) return;
    editor.focus();
    editor.setRangeText(text, editor.selectionStart, editor.selectionEnd, 'end');
    editor.dispatchEvent(new Event('input', { bubbles: true }));
  }

  let activeServerProfileGuildId = '';

  async function initializeServerProfileSelector() {
    const select = document.getElementById('serverProfileSelect');
    try {
      const response = await fetch('/api/server-profiles').then(r => r.json());
      if (!response.ok || !Array.isArray(response.profiles) || !Array.isArray(response.availableGuilds)) {
        throw new Error(response.error || 'Serverliste nicht verfügbar');
      }
      select.replaceChildren();
      for (const guild of response.profiles) {
        const option = document.createElement('option');
        option.value = guild.id;
        option.textContent = guild.name;
        select.appendChild(option);
      }
      if (!response.profiles.length) select.appendChild(new Option('Noch kein Profil angelegt', ''));
      activeServerProfileGuildId = response.profiles.some(guild => guild.id === response.primaryGuildId)
        ? response.primaryGuildId
        : response.profiles[0]?.id || '';
      select.value = activeServerProfileGuildId;
      select.disabled = response.profiles.length < 2;

      const createSelect = document.getElementById('serverProfileCreateGuild');
      createSelect.replaceChildren(new Option(
        response.availableGuilds.length ? 'Beigetretenen Server auswählen …' : 'Keine weiteren beigetretenen Server',
        ''
      ));
      for (const guild of response.availableGuilds) createSelect.add(new Option(guild.name, guild.id));
      document.getElementById('btnCreateServerProfile').disabled = false;
      document.getElementById('btnConfirmCreateServerProfile').disabled = false;
      document.getElementById('btnCfgSave').textContent = configSaveButtonLabel();
    } catch (error) {
      select.replaceChildren(new Option('Serverprofile nicht verfügbar', ''));
      select.disabled = true;
      document.getElementById('cfgStatus').textContent = error.message;
      document.getElementById('cfgStatus').className = 'warn';
    }
  }

  function toggleServerProfileCreate(show) {
    const controls = document.getElementById('serverProfileCreateControls');
    controls.hidden = show === undefined ? !controls.hidden : !show;
  }

  function fillServerProfileGuild(guildId) {
    const guild = Array.from(document.getElementById('serverProfileCreateGuild').options)
      .find(option => option.value === guildId);
    if (!guildId || !guild) return;
    document.getElementById('serverProfileCreateGuildId').value = guildId;
    document.getElementById('serverProfileCreateGuildName').value = guild.textContent;
  }

  async function createServerProfile() {
    const guildId = document.getElementById('serverProfileCreateGuildId').value.trim()
      || document.getElementById('serverProfileCreateGuild').value;
    const guildName = document.getElementById('serverProfileCreateGuildName').value.trim();
    const status = document.getElementById('cfgStatus');
    const button = document.getElementById('btnConfirmCreateServerProfile');
    if (!guildId) {
      status.textContent = 'Bitte einen Server auswählen oder eine Guild-ID eingeben.';
      status.className = 'warn';
      return;
    }
    button.disabled = true;
    try {
      const result = await fetch('/api/server-profiles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guildId, guildName }),
      }).then(r => r.json());
      if (!result.ok) throw new Error(result.error || 'Serverprofil konnte nicht angelegt werden.');
      await initializeServerProfileSelector();
      activeServerProfileGuildId = guildId;
      document.getElementById('serverProfileSelect').value = guildId;
      document.getElementById('btnCfgSave').textContent = configSaveButtonLabel();
      toggleServerProfileCreate(false);
      clearConfigDirtyTracking();
      await loadConfig({ force: true });
      initConfigDirtyTracking();
      status.textContent = `Profil für ${result.profile.guildName} angelegt.`;
      status.className = 'ok';
      document.getElementById('serverProfileCreateGuildId').value = '';
      document.getElementById('serverProfileCreateGuildName').value = '';
      document.getElementById('serverProfileCreateGuild').value = '';
    } catch (error) {
      status.textContent = error.message;
      status.className = 'err';
    } finally {
      button.disabled = false;
    }
  }

  async function switchServerProfile(guildId) {
    if (guildId === activeServerProfileGuildId) return;
    const select = document.getElementById('serverProfileSelect');
    const dirty = document.getElementById('cfgDirtyState')?.classList.contains('show');
    if (dirty && !window.confirm('Ungespeicherte Änderungen verwerfen und Serverprofil wechseln?')) {
      select.value = activeServerProfileGuildId;
      return;
    }
    activeServerProfileGuildId = guildId;
    document.getElementById('btnCfgSave').textContent = configSaveButtonLabel();
    clearConfigDirtyTracking();
    await loadConfig({ force: true });
    initConfigDirtyTracking();
  }

  let openLigaDbLeaguesCache = null;
  const openLigaDbTeamsCache = new Map();

  async function ensureOpenLigaDbLeagues() {
    if (openLigaDbLeaguesCache) return openLigaDbLeaguesCache;
    const response = await fetch('/api/openligadb/leagues').then(result => result.json());
    if (!response.ok) throw new Error(response.error || 'Ligenliste nicht verfügbar');
    openLigaDbLeaguesCache = response.leagues || [];
    return openLigaDbLeaguesCache;
  }

  function getOpenLigaDbFavoriteLimit(row) {
    const value = Number(row.querySelector('[data-openliga-role="max-favorites"]').value);
    return Number.isInteger(value) ? Math.min(40, Math.max(1, value)) : 5;
  }

  function updateOpenLigaDbCountdownOptions(row) {
    const select = row.querySelector('[data-openliga-role="countdown-team"]');
    const favoriteCheckboxes = Array.from(row.querySelectorAll('[data-openliga-role="favorites"] input[type="checkbox"]:checked'));
    const savedValue = String(select.dataset.savedValue || select.value || '');
    select.replaceChildren(new Option(
      favoriteCheckboxes.length ? 'Countdown deaktiviert' : 'Zuerst eine Favoritenmannschaft auswählen',
      '',
    ));
    for (const checkbox of favoriteCheckboxes) {
      const option = new Option(
        checkbox.closest('label')?.querySelector('span')?.textContent.trim() || `Team ${checkbox.value}`,
        checkbox.value,
      );
      select.add(option);
    }
    select.value = favoriteCheckboxes.some(checkbox => checkbox.value === savedValue) ? savedValue : '';
    select.dataset.savedValue = select.value;
    select.disabled = favoriteCheckboxes.length === 0;
    const previewButton = row.querySelector('[data-openliga-role="countdown-preview-button"]');
    const preview = row.querySelector('[data-openliga-role="countdown-preview"]');
    if (previewButton) previewButton.disabled = !select.value;
    if (!select.value) {
      row.dataset.countdownPreviewRequest = String(Number(row.dataset.countdownPreviewRequest || 0) + 1);
      preview.hidden = true;
    }
    else if (!preview.hidden) {
      void renderOpenLigaDbCountdownPreview(row);
    }
  }

  function formatOpenLigaDbDiscordTimestamp(timestamp, format) {
    const date = new Date(Number(timestamp) * 1000);
    if (!Number.isFinite(date.getTime())) return '';
    if (format === 'R') {
      const seconds = Math.round((date.getTime() - Date.now()) / 1000);
      const units = [
        ['year', 31_536_000],
        ['month', 2_592_000],
        ['week', 604_800],
        ['day', 86_400],
        ['hour', 3_600],
        ['minute', 60],
        ['second', 1],
      ];
      const [unit, unitSeconds] = units.find(([, size]) => Math.abs(seconds) >= size) || units[units.length - 1];
      return new Intl.RelativeTimeFormat('de-DE', { numeric: 'auto' }).format(Math.round(seconds / unitSeconds), unit);
    }
    const options = format === 'F'
      ? { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }
      : format === 'f'
        ? { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }
        : format === 'D'
          ? { day: 'numeric', month: 'long', year: 'numeric' }
          : format === 'd'
            ? { day: '2-digit', month: '2-digit', year: 'numeric' }
            : format === 'T'
              ? { hour: '2-digit', minute: '2-digit', second: '2-digit' }
              : { hour: '2-digit', minute: '2-digit' };
    return new Intl.DateTimeFormat('de-DE', options).format(date);
  }

  function formatOpenLigaDbEmbedText(value) {
    return String(value || '')
      .replace(/[&<>"']/g, character => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      })[character])
      .replace(/&lt;t:(\d+):([a-zA-Z])&gt;/g, (_match, timestamp, format) =>
        formatOpenLigaDbDiscordTimestamp(timestamp, format))
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br>');
  }

  async function renderOpenLigaDbCountdownPreview(row) {
    const select = row.querySelector('[data-openliga-role="countdown-team"]');
    const preview = row.querySelector('[data-openliga-role="countdown-preview"]');
    const status = row.querySelector('[data-openliga-role="countdown-preview-status"]');
    const selectedTeam = select.selectedOptions[0];
    if (!select.value || !selectedTeam) return;

    const [teamName] = selectedTeam.textContent.split(' · ');
    const button = row.querySelector('[data-openliga-role="countdown-preview-button"]');
    const requestId = Number(row.dataset.countdownPreviewRequest || 0) + 1;
    row.dataset.countdownPreviewRequest = String(requestId);
    button.disabled = true;
    status.textContent = 'Embed-Vorschau wird erstellt …';
    status.className = 'cfg-hint';
    try {
      const response = await fetch('/api/openligadb/countdown-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          teamId: select.value,
          teamName: teamName.trim(),
          leagueName: row.querySelector('[data-openliga-role="title"]').textContent.trim(),
          countdownStyle: row.querySelector('[data-openliga-role="countdown-style"]').value,
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'Embed-Vorschau konnte nicht erstellt werden.');
      if (requestId !== Number(row.dataset.countdownPreviewRequest)) return;

      const embed = result.embed;
      const accent = Number.isInteger(embed.color) ? `#${embed.color.toString(16).padStart(6, '0')}` : '#d6b32a';
      preview.style.borderLeftColor = accent;
      const author = preview.querySelector('[data-openliga-role="countdown-preview-author"]');
      author.textContent = embed.author?.name || '';
      author.hidden = !embed.author?.name;
      preview.querySelector('[data-openliga-role="countdown-preview-title"]').textContent = embed.title || '';
      preview.querySelector('[data-openliga-role="countdown-preview-description"]').innerHTML = formatOpenLigaDbEmbedText(embed.description);
      preview.querySelector('[data-openliga-role="countdown-preview-footer"]').textContent = embed.footer?.text || '';
      const fields = preview.querySelector('[data-openliga-role="countdown-preview-fields"]');
      fields.replaceChildren();
      for (const field of embed.fields || []) {
        const fieldElement = document.createElement('div');
        const name = document.createElement('strong');
        name.textContent = field.name;
        const value = document.createElement('div');
        value.innerHTML = formatOpenLigaDbEmbedText(field.value);
        value.style.marginTop = '4px';
        fieldElement.append(name, value);
        fields.appendChild(fieldElement);
      }
      status.textContent = `Vorschau: ${select.selectedOptions[0]?.textContent || 'Countdown'} · Beispieldaten`;
      preview.hidden = false;
    } catch (error) {
      if (requestId !== Number(row.dataset.countdownPreviewRequest)) return;
      status.textContent = error.message;
      status.className = 'cfg-hint err';
    } finally {
      if (requestId === Number(row.dataset.countdownPreviewRequest)) {
        button.disabled = !select.value;
      }
    }
  }

  function updateOpenLigaDbFavoriteSelection(row, trimOverflow = false) {
    const teamList = row.querySelector('[data-openliga-role="favorites"]');
    const status = row.querySelector('[data-openliga-role="status"]');
    const checkboxes = Array.from(teamList.querySelectorAll('input[type="checkbox"]'));
    const limit = getOpenLigaDbFavoriteLimit(row);
    let selected = checkboxes.filter(checkbox => checkbox.checked);
    if (trimOverflow && selected.length > limit) {
      selected.slice(limit).forEach(checkbox => { checkbox.checked = false; });
      selected = selected.slice(0, limit);
    }
    checkboxes.forEach(checkbox => {
      checkbox.disabled = !checkbox.checked && selected.length >= limit;
    });
    status.textContent = `${row.dataset.openligaTeamCount || 0} Teams · ${selected.length}/${limit} Favoriten`;
    status.className = 'cfg-hint';
    updateOpenLigaDbCountdownOptions(row);
  }

  function populateOpenLigaDbAddLeagueOptions(leagues) {
    const select = document.getElementById('cfgOpenLigaDbNewLeague');
    if (!select) return;
    const previousValue = select.value;
    select.replaceChildren();
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Liga und Saison auswählen …';
    select.appendChild(placeholder);
    for (const league of leagues) {
      const option = document.createElement('option');
      option.value = `${league.leagueShortcut}|${league.leagueSeason}`;
      option.textContent = getOpenLigaDbLeagueLabel(league);
      select.appendChild(option);
    }
    if (Array.from(select.options).some(option => option.value === previousValue)) {
      select.value = previousValue;
    }
  }

  function getOpenLigaDbLeagueLabel(league) {
    const name = String(league.leagueName || league.leagueShortcut || 'Liga');
    const season = Number(league.leagueSeason);
    if (!Number.isInteger(season)) return name;
    const nextSeasonShort = String(season + 1).slice(-2);
    const seasonPattern = new RegExp(`\\b${season}(?:\\s*[/.-]\\s*(?:${season + 1}|${nextSeasonShort}))?\\b`);
    return seasonPattern.test(name) ? name : `${name} · ${season}`;
  }

  async function addSelectedOpenLigaDbFeed() {
    const status = document.getElementById('cfgOpenLigaDbStatus');
    try {
      const select = document.getElementById('cfgOpenLigaDbNewLeague');
      const [leagueShortcut, seasonValue] = String(select.value || '').split('|');
      const season = Number(seasonValue);
      if (!leagueShortcut || !Number.isInteger(season)) {
        throw new Error('Bitte zuerst eine Liga und Saison auswählen.');
      }
      const leagues = await ensureOpenLigaDbLeagues();
      const league = leagues.find(item => item.leagueShortcut === leagueShortcut && item.leagueSeason === season);
      if (!league) throw new Error('Diese Liga ist aktuell nicht verfügbar.');
      const alreadyAdded = serializeOpenLigaDbFeeds().some(feed =>
        feed.leagueShortcut === league.leagueShortcut && feed.season === league.leagueSeason);
      if (alreadyAdded) {
        status.textContent = `${league.leagueName} ist bereits hinzugefügt.`;
        status.className = 'cfg-hint warn';
        return;
      }
      await addOpenLigaDbFeed({ leagueShortcut: league.leagueShortcut, season: league.leagueSeason }, { selectAfterAdd: true });
      select.value = '';
      status.textContent = '';
      status.className = 'cfg-hint';
    } catch (error) {
      status.textContent = error.message;
      status.className = 'cfg-hint err';
    }
  }

  async function loadOpenLigaDbTeams(row, selectedTeamIds = []) {
    const leagueSelect = row.querySelector('[data-openliga-role="league"]');
    const teamSelect = row.querySelector('[data-openliga-role="favorites"]');
    const status = row.querySelector('[data-openliga-role="status"]');
    const [leagueShortcut, season] = leagueSelect.value.split('|');
    if (!leagueShortcut || !season) return;
    teamSelect.replaceChildren();
    row.dataset.openligaTeamCount = '0';
    const cacheKey = `${leagueShortcut}:${season}`;
    try {
      if (!openLigaDbTeamsCache.has(cacheKey)) {
        const query = new URLSearchParams({ leagueShortcut, season });
        const response = await fetch(`/api/openligadb/teams?${query}`).then(result => result.json());
        if (!response.ok) throw new Error(response.error || 'Teamliste nicht verfügbar');
        openLigaDbTeamsCache.set(cacheKey, response.teams || []);
      }
      const selectedIds = new Set(selectedTeamIds.map(String));
      teamSelect.replaceChildren();
      for (const team of openLigaDbTeamsCache.get(cacheKey)) {
        const teamId = String(team.teamId);
        const label = document.createElement('label');
        label.style.cssText = 'display:flex;align-items:center;gap:8px;padding:4px 6px;cursor:pointer';
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.value = teamId;
        checkbox.checked = selectedIds.has(teamId);
        checkbox.style.cssText = 'width:16px;height:16px;flex:none;accent-color:var(--green)';
        const name = document.createElement('span');
        name.textContent = team.shortName === team.teamName ? team.teamName : `${team.shortName} · ${team.teamName}`;
        label.append(checkbox, name);
        teamSelect.appendChild(label);
        selectedIds.delete(teamId);
      }
      for (const teamId of selectedIds) {
        const label = document.createElement('label');
        label.style.cssText = 'display:flex;align-items:center;gap:8px;padding:4px 6px;cursor:pointer';
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.value = teamId;
        checkbox.checked = true;
        checkbox.style.cssText = 'width:16px;height:16px;flex:none;accent-color:var(--green)';
        const name = document.createElement('span');
        name.textContent = `Gespeichertes Team (${teamId})`;
        label.append(checkbox, name);
        teamSelect.appendChild(label);
      }
      const availableTeams = openLigaDbTeamsCache.get(cacheKey);
      row.dataset.openligaTeamCount = String(availableTeams.length);
      updateOpenLigaDbFavoriteSelection(row, true);
      if (!availableTeams.length) {
        status.textContent = leagueShortcut === 'unl'
          ? `OpenLigaDB liefert für die Nations League ${season} derzeit keine Teilnehmer. Für Deutschlands Nations-League-Spiele bitte „DFB Nationalspiele“ auswählen.`
          : `OpenLigaDB liefert für ${leagueShortcut} ${season} derzeit keine Teilnehmer.`;
        status.className = 'cfg-hint warn';
      }
    } catch (error) {
      status.textContent = error.message;
      status.className = 'cfg-hint err';
    }
  }

