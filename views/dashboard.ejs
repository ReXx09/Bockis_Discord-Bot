  async function _resolveCleanupChannelName(row) {
    const idInput = row.querySelector('.cleanup-ch-id');
    const nameLabel = row.querySelector('.cleanup-ch-name');
    const id = String(idInput?.value || '').trim();
    if (!nameLabel) return;
    if (!/^\d{5,20}$/.test(id)) {
      nameLabel.textContent = id ? 'Ungültige Channel-ID' : 'Kanalname wird anhand der ID erkannt';
      return;
    }

    nameLabel.textContent = 'Kanal wird gesucht...';
    try {
      const response = await fetch(`/api/discord/channels/${encodeURIComponent(id)}`);
      const data = await response.json().catch(() => ({}));
      if (String(idInput.value || '').trim() !== id) return;
      if (!response.ok || !data.name) {
        nameLabel.textContent = data.error || 'Kanal nicht erreichbar';
        return;
      }
      nameLabel.textContent = `#${data.name}${data.guildName ? ` · ${data.guildName}` : ''}`;
    } catch {
      if (String(idInput.value || '').trim() === id) nameLabel.textContent = 'Kanalname derzeit nicht abrufbar';
    }
  }

  function addCleanupChannelRow(id = '', overrides = {}) {
    const container = document.getElementById('cleanupChannelRows');
    if (!container) return;
    const row = document.createElement('div');
    row.className = 'cleanup-channel-row';
    const mm = overrides.maxmessages !== undefined ? String(overrides.maxmessages) : '';
    const ma = overrides.maxagehours !== undefined ? String(overrides.maxagehours) : '';
    const iv = overrides.cleanupintervalms !== undefined ? String(overrides.cleanupintervalms) : '';
    row.innerHTML = `
      <input class="cfg-input cleanup-ch-id" type="text" placeholder="Channel-ID" value="${id}" maxlength="20" style="font-family:monospace;font-size:13px" autocomplete="off">
      <span class="cleanup-ch-name" role="status" aria-live="polite" title="Kanalname wird anhand der ID erkannt" style="font-size:12px;color:var(--text-muted,#9aa)">Kanalname wird anhand der ID erkannt</span>
      <select class="cfg-input cleanup-sel-mm" title="Max. Nachrichten im Kanal" style="font-size:12px">${_mkCleanupMaxMsgOpts(mm)}</select>
      <select class="cfg-input cleanup-sel-ma" title="Nachrichten älter als (Stunden)" style="font-size:12px">${_mkCleanupMaxAgeOpts(ma)}</select>
      <select class="cfg-input cleanup-sel-iv" title="Cleanup-Intervall" style="font-size:12px">${_mkCleanupIntervalOpts(iv)}</select>
      <button class="cleanup-row-remove" type="button" title="Kanal entfernen" style="padding:0;width:26px;height:26px;border-radius:5px;border:1px solid var(--border);background:rgba(220,50,50,.15);color:#f88;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0">✕</button>
    `;
    row.querySelector('button').addEventListener('click', () => row.remove());
    row.querySelector('.cleanup-ch-id').addEventListener('blur', () => _resolveCleanupChannelName(row));
    container.appendChild(row);
    if (id) _resolveCleanupChannelName(row);
  }
  function syncCleanupRowsToHiddenInput() {
    const el = document.getElementById('cfgMsgCleanupChannelIds');
    if (!el) return;
    const rows = document.querySelectorAll('#cleanupChannelRows .cleanup-channel-row');
    const parts = [];
    for (const row of rows) {
      const id = row.querySelector('.cleanup-ch-id').value.trim();
      if (!/^\d{5,}$/.test(id)) continue;
      let entry = id;
      const mm = row.querySelector('.cleanup-sel-mm').value;
      const ma = row.querySelector('.cleanup-sel-ma').value;
      const iv = row.querySelector('.cleanup-sel-iv').value;
      if (mm !== '') entry += `:maxMessages=${mm}`;
      if (ma !== '') entry += `:maxAgeHours=${ma}`;
      if (iv !== '') entry += `:cleanupIntervalMs=${iv}`;
      parts.push(entry);
    }
    el.value = parts.join(',');
  }
  function deserializeCleanupRows(raw) {
    const container = document.getElementById('cleanupChannelRows');
    if (!container) return;
    container.innerHTML = '';
    if (!raw) return;
    for (const entry of raw.split(',')) {
      const parts = entry.trim().split(':');
      const id = parts[0].trim();
      if (!/^\d{5,}$/.test(id)) continue;
      const overrides = {};
      for (const part of parts.slice(1)) {
        const eq = part.indexOf('=');
        if (eq < 0) continue;
        overrides[part.slice(0, eq).toLowerCase()] = part.slice(eq + 1);
      }
      addCleanupChannelRow(id, overrides);
    }
  }
