<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bockis Bot – Dashboard</title>
  <style>
    :root {
      --bg:       #0d1117;
      --surface:  #161b22;
      --surface2: #21262d;
      --border:   #30363d;
      --text:     #e6edf3;
      --muted:    #8b949e;
      --green:    #3fb950;
      --red:      #f85149;
      --yellow:   #d29922;
      --blue:     #388bfd;
      --purple:   #8957e5;
      --radius:   8px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 24px;
    }

    /* HEADER */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }
    .header h1 { font-size: 20px; font-weight: 600; }
    .header .sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .header-right { display: flex; align-items: center; gap: 12px; position: relative; z-index: 1; }
    .timer { font-size: 12px; color: var(--muted); }

    /* SUBNAV */
    .subnav {
      display: flex;
      gap: 4px;
      flex-wrap: wrap;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      background: transparent;
    }
    @media (max-width: 1200px) {
      .header { flex-wrap: wrap; gap: 12px; }
      .subnav { position: static; left: auto; transform: none; width: 100%; justify-content: center; order: 3; }
      .header-right { margin-left: auto; }
    }
    .subnav-btn {
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--muted);
      padding: 7px 12px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .03em;
    }
    .subnav-btn:hover { color: var(--text); border-color: var(--blue); }
    .subnav-btn.active {
      background: rgba(56,139,253,.18);
      color: #c8e1ff;
      border-color: rgba(56,139,253,.75);
      box-shadow: inset 0 0 0 1px rgba(56,139,253,.2);
    }
    .pane-hidden { display: none !important; }

    /* BUTTONS */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--text);
      font-size: 13px;
      cursor: pointer;
      transition: background .15s;
    }
    .btn:hover { background: var(--border); }
    .btn-green { background: #238636; border-color: #2ea043; color: #fff; }
    .btn-green:hover { background: #2ea043; }
    .btn-green:disabled { opacity: .6; cursor: not-allowed; }
    .btn-small { padding: 4px 8px; font-size: 11px; }

    /* GRID */
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }
    @media (max-width: 680px) { .grid-2 { grid-template-columns: 1fr; } }
    .grid-monitors {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 12px;
    }

    /* DASHBOARD GRID LAYOUT */
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(24, minmax(0, 1fr));
      gap: 16px;
    }
    .dashboard-grid > .card {
      min-width: 0;
      grid-column: span 24;
    }
    .dashboard-grid > .card[data-pane="diagnostics"] {
      align-self: start;
    }
    #logsCard, #repairDiagCard { align-self: stretch; }
    #repairLogDiag {
      height: 260px;
      min-height: 260px;
      max-height: 260px;
      overflow-y: auto;
    }
    .dashboard-grid > .card[data-span="3"]  { grid-column: span 3; }
    .dashboard-grid > .card[data-span="4"]  { grid-column: span 4; }
    .dashboard-grid > .card[data-span="6"]  { grid-column: span 6; }
    .dashboard-grid > .card[data-span="8"]  { grid-column: span 8; }
    .dashboard-grid > .card[data-span="9"]  { grid-column: span 9; }
    .dashboard-grid > .card[data-span="12"] { grid-column: span 12; }
    .dashboard-grid > .card[data-span="15"] { grid-column: span 15; }
    .dashboard-grid > .card[data-span="16"] { grid-column: span 16; }
    .dashboard-grid > .card[data-span="18"] { grid-column: span 18; }
    .dashboard-grid > .card[data-span="20"] { grid-column: span 20; }
    .dashboard-grid > .card[data-span="21"] { grid-column: span 21; }
    .dashboard-grid > .card[data-span="24"] { grid-column: span 24; }
    .dashboard-grid > .drop-placeholder[data-span="3"]  { grid-column: span 3; }
    .dashboard-grid > .drop-placeholder[data-span="4"]  { grid-column: span 4; }
    .dashboard-grid > .drop-placeholder[data-span="6"]  { grid-column: span 6; }
    .dashboard-grid > .drop-placeholder[data-span="8"]  { grid-column: span 8; }
    .dashboard-grid > .drop-placeholder[data-span="9"]  { grid-column: span 9; }
    .dashboard-grid > .drop-placeholder[data-span="12"] { grid-column: span 12; }
    .dashboard-grid > .drop-placeholder[data-span="15"] { grid-column: span 15; }
    .dashboard-grid > .drop-placeholder[data-span="16"] { grid-column: span 16; }
    .dashboard-grid > .drop-placeholder[data-span="18"] { grid-column: span 18; }
    .dashboard-grid > .drop-placeholder[data-span="20"] { grid-column: span 20; }
    .dashboard-grid > .drop-placeholder[data-span="21"] { grid-column: span 21; }
    .dashboard-grid > .drop-placeholder[data-span="24"] { grid-column: span 24; }
    @media (max-width: 900px) {
      .dashboard-grid { grid-template-columns: minmax(0, 1fr); }
      .dashboard-grid > .card { grid-column: 1 / -1 !important; }
    }

    .card-size-select {
      background: var(--surface2);
      border: 1px solid var(--border);
      color: var(--muted);
      cursor: pointer;
      font-size: 11px;
      padding: 4px 8px;
      border-radius: 6px;
      transition: color .15s, border-color .15s;
      min-width: 92px;
    }
    .card-size-select:hover,
    .card-size-select:focus {
      color: var(--text);
      border-color: var(--blue);
      outline: none;
    }

    /* CARD */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
    }
    .card.dragging { opacity: 0.5; will-change: opacity; }
    .card.drag-over { border-color: var(--blue); box-shadow: 0 0 0 2px rgba(56,139,253,.2); }
    .drop-placeholder {
      min-height: 96px;
      border: 2px dashed rgba(56,139,253,.75);
      border-radius: var(--radius);
      background: rgba(56,139,253,.08);
      box-shadow: 0 0 0 2px rgba(56,139,253,.16), 0 0 18px rgba(56,139,253,.24);
      pointer-events: none;
      animation: dropPulse .9s ease-in-out infinite alternate;
      will-change: grid-column;
    }
    @keyframes dropPulse {
      from { box-shadow: 0 0 0 1px rgba(56,139,253,.14), 0 0 8px rgba(56,139,253,.18); }
      to   { box-shadow: 0 0 0 2px rgba(56,139,253,.28), 0 0 22px rgba(56,139,253,.34); }
    }
    
    /* CARD WRAPPER MIT COLLAPSE */
    .card-wrapper {
      display: flex;
      flex-direction: column;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
      cursor: grab;
      user-select: none;
    }
    .card-header:active { cursor: grabbing; }
    .card-header-left { display: flex; align-items: center; gap: 8px; flex: 1; }
    .card-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--muted);
      margin: 0;
    }
    .card-controls { display: flex; gap: 6px; }
    .btn-collapse {
      background: none;
      border: none;
      color: var(--muted);
      cursor: pointer;
      font-size: 14px;
      padding: 4px 8px;
      transition: color .15s;
      width: 28px; height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .btn-collapse:hover { color: var(--text); }
    
    .card-content {
      min-width: 0;
      overflow: hidden;
      transition: max-height .25s ease, opacity .25s ease;
      max-height: 2000px;
      opacity: 1;
    }
    .card-content.collapsed {
      max-height: 0;
      opacity: 0;
      pointer-events: none;
    }

    /* INFO ROW */
    .row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      min-width: 0;
      padding: 7px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .row:last-child { border-bottom: none; }
    .row-label { color: var(--muted); flex: 0 0 auto; }
    .row-value {
      min-width: 0;
      text-align: right;
      overflow-wrap: anywhere;
      word-break: break-word;
      font-weight: 500;
      font-family: 'SFMono-Regular', Consolas, monospace;
    }

    /* BADGE */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .04em;
    }
    .b-green  { background: rgba(63,185,80,.15);  color: var(--green); }
    .b-red    { background: rgba(248,81,73,.15);   color: var(--red); }
    .b-yellow { background: rgba(210,153,34,.15);  color: var(--yellow); }
    .b-gray   { background: rgba(139,148,158,.15); color: var(--muted); }
    .b-purple { background: rgba(137,87,229,.15);  color: var(--purple); }

    /* DOT */
    .dot {
      display: inline-block;
      width: 8px; height: 8px;
      border-radius: 50%;
      margin-right: 5px;
    }
    .dot-g { background: var(--green); box-shadow: 0 0 5px var(--green); }
    .dot-r { background: var(--red);   box-shadow: 0 0 5px var(--red); }

    /* MONITOR CARD */
    .mc {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      position: relative;
      overflow: hidden;
    }
    .mc::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .mc.online::before  { background: var(--green); }
    .mc.offline::before { background: var(--red); }
    .mc.pending::before { background: var(--yellow); }
    .mc.inactive::before{ background: var(--muted); }
    .mc-name {
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .mc-group { font-size: 11px; color: var(--muted); margin-bottom: 10px; }

    /* METRIC KACHELN */
    .metric-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 10px;
      margin-bottom: 0;
    }
    .metric-tile {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
    }
    .metric-icon { font-size: 18px; line-height: 1; }
    .metric-label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
    .metric-value { font-size: 22px; font-weight: 700; line-height: 1.1; color: var(--text); }
    .metric-sub   { font-size: 11px; color: var(--muted); }
    .metric-bar-wrap { height: 4px; background: var(--surface); border-radius: 2px; overflow: hidden; margin-top: 2px; }
    .metric-bar { height: 100%; border-radius: 2px; transition: width .6s ease; }
    .metric-bar.ok   { background: var(--green); }
    .metric-bar.warn { background: var(--yellow); }
    .metric-bar.crit { background: var(--red); }
    .metric-na { font-size: 13px; color: var(--muted); font-style: italic; }

    .uptime-bar {
      height: 4px;
      background: var(--surface2);
      border-radius: 2px;
      margin: 8px 0;
      overflow: hidden;
    }
    .uptime-fill { height: 100%; border-radius: 2px; transition: width .5s ease; }
    .uf-g { background: var(--green); }
    .uf-y { background: var(--yellow); }
    .uf-r { background: var(--red); }
    .mc-meta {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--muted);
      margin-top: 6px;
    }

    /* SERVICE CONTROL */
    .svc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 12px;
    }
    .svc-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .svc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .svc-name { font-size: 13px; font-weight: 600; }
    .svc-actions { display: flex; gap: 6px; }
    .btn-svc {
      padding: 4px 10px;
      font-size: 11px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--text);
      cursor: pointer;
      transition: background .15s;
    }
    .btn-svc:hover { background: var(--border); }
    .btn-svc.start  { color: var(--green); border-color: rgba(63,185,80,.4); }
    .btn-svc.stop   { color: var(--red);   border-color: rgba(248,81,73,.4); }
    .btn-svc.restart{ color: var(--yellow);border-color: rgba(210,153,34,.4); }
    .btn-svc:disabled { opacity: .45; cursor: not-allowed; }

    /* SECTION */
    .section-hdr {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 24px 0 12px;
    }
    .section-hdr .title { font-size: 14px; font-weight: 600; }
    .section-hdr .count {
      font-size: 12px;
      color: var(--muted);
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 2px 10px;
    }

    /* LOG VIEWER */
    .log-viewer {
      background: #010409;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      height: 260px;
      overflow-y: auto;
      font-family: 'SFMono-Regular', Consolas, monospace;
      font-size: 12px;
      line-height: 1.65;
      user-select: text;
      -webkit-user-select: text;
      cursor: text;
    }
    .ll { color: var(--muted); padding: 1px 0; white-space: pre-wrap; word-break: break-all; }
    .ll.e { color: var(--red); }
    .ll.w { color: var(--yellow); }
    .ll.i { color: var(--text); }

    /* SKELETON */
    .sk {
      background: linear-gradient(90deg, var(--surface2) 25%, var(--border) 50%, var(--surface2) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.4s infinite;
      border-radius: 4px;
      height: 13px;
      margin-bottom: 14px;
    }
    @keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

    /* TOAST */
    #toast {
      position: fixed;
      bottom: 24px; right: 24px;
      padding: 12px 18px;
      border-radius: var(--radius);
      font-size: 13px;
      background: var(--surface2);
      border: 1px solid var(--border);
      display: none;
      z-index: 999;
      box-shadow: 0 4px 20px rgba(0,0,0,.5);
    }
    #toast.show  { display: block; animation: fiu .25s ease; }
    #toast.ok    { border-color: var(--green); color: var(--green); }
    #toast.err   { border-color: var(--red);   color: var(--red); }
    @keyframes fiu { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:none} }

    .muted { color: var(--muted); font-size: 12px; }
    .mb12  { margin-bottom: 12px; }

    /* UPDATE BANNER */
    #updateBanner {
      display: none;
      background: rgba(210,153,34,.08);
      border: 1px solid rgba(210,153,34,.4);
      border-radius: var(--radius);
      padding: 14px 18px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    #updateBanner.hidden { display: none !important; }
    .ub-left { display: flex; align-items: center; gap: 10px; }
    .ub-icon { font-size: 20px; }
    .ub-title { font-size: 14px; font-weight: 600; color: var(--yellow); }
    .ub-sub   { font-size: 12px; color: var(--muted); margin-top: 2px; }


    .commit-list { margin-top: 10px; }
    .commit {
      display: flex; gap: 12px; align-items: baseline;
      padding: 6px 0; border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .commit:last-child { border-bottom: none; }
    .commit-hash {
      font-family: 'SFMono-Regular', Consolas, monospace;
      font-size: 11px; color: var(--blue);
      min-width: 52px;
    }
    .commit-msg  { flex: 1; color: var(--text); }
    .commit-when { font-size: 11px; color: var(--muted); white-space: nowrap; }

    /* TERMINAL OUTPUT */
    #updateLog, .update-log {
      background: #010409;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
      height: 200px;
      overflow-y: auto;
      font-family: 'SFMono-Regular', Consolas, monospace;
      font-size: 12px;
      line-height: 1.6;
      display: none;
      margin-top: 12px;
      user-select: text;
      -webkit-user-select: text;
      cursor: text;
    }
    #updateLog.visible, .update-log.visible { display: block; }
    .ul-line { white-space: pre-wrap; word-break: break-all; color: var(--muted); }
    .ul-ok   { color: var(--green); }
    .ul-err  { color: var(--red); }
    .ul-warn { color: var(--yellow); }

    /* DEPS TABLE */
    .deps-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 12px; }
    .deps-table th {
      text-align: left; font-size: 10px; font-weight: 600;
      text-transform: uppercase; letter-spacing: .06em;
      color: var(--muted); padding: 5px 10px;
      border-bottom: 1px solid var(--border);
    }
    .deps-table td { padding: 6px 10px; border-bottom: 1px solid rgba(255,255,255,.04); font-family: 'SFMono-Regular', Consolas, monospace; vertical-align: middle; }
    .deps-table tr:last-child td { border-bottom: none; }
    .deps-table tr:hover td { background: rgba(255,255,255,.03); }
    .dep-name  { font-weight: 600; color: var(--text); }
    .dep-dev   { font-size: 10px; color: var(--muted); margin-left: 4px; }
    .dep-ver   { color: var(--muted); }
    .dep-badge {
      display: inline-block; padding: 2px 7px; border-radius: 4px;
      font-size: 10px; font-weight: 700; letter-spacing: .03em;
    }
    .dep-ok-badge   { background: rgba(63,185,80,.12);  color: var(--green); }
    .dep-warn-badge { background: rgba(210,153,34,.12); color: var(--yellow); }
    .dep-crit-badge { background: rgba(248,81,73,.12);  color: var(--red); }

    /* CONFIG FORM */
    .cfg-form { margin-top: 4px; }
    .cfg-layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 12px;
      margin-bottom: 10px;
      align-items: start;
    }
    .cfg-sidebar {
      border: 1px solid var(--border);
      background: linear-gradient(180deg, rgba(17,23,33,.9), rgba(17,23,33,.72));
      border-radius: 10px;
      padding: 10px;
      position: sticky;
      top: 18px;
      max-height: calc(100vh - 36px);
      overflow-y: auto;
    }
    .cfg-sidebar-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--blue);
      margin-bottom: 8px;
      border-bottom: 1px solid rgba(255,255,255,.06);
      padding-bottom: 6px;
    }
    .cfg-nav {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .cfg-nav-btn {
      text-align: left;
      padding: 9px 10px;
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--muted);
      border-radius: 8px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .02em;
      transition: all .15s;
    }
    .cfg-nav-btn:hover { color: var(--text); border-color: var(--blue); }
    .cfg-nav-btn.active {
      color: #c8e1ff;
      border-color: rgba(56,139,253,.75);
      background: rgba(56,139,253,.16);
      box-shadow: inset 0 0 0 1px rgba(56,139,253,.2);
    }
    .cfg-nav-group { border: 1px solid var(--border); border-radius: 7px; overflow: hidden; background: var(--surface2); }
    .cfg-nav-group .cfg-nav-btn { border: 0; border-radius: 0; width: 100%; }
    .cfg-nav-group .cfg-nav-btn::after { content: '▸'; float: right; color: var(--muted); transition: transform .15s ease; }
    .cfg-nav-group.open .cfg-nav-btn::after { transform: rotate(90deg); }
    .cfg-nav-sections { display: none; padding: 3px 6px 7px; border-top: 1px solid var(--border); }
    .cfg-nav-group.open .cfg-nav-sections { display: grid; gap: 3px; }
    .cfg-nav-section-btn {
      width: 100%; text-align: left; padding: 7px 8px 7px 12px; border: 0; border-radius: 5px;
      background: transparent; color: var(--muted); cursor: pointer; font-size: 11px; line-height: 1.35;
    }
    .cfg-nav-section-btn:hover, .cfg-nav-section-btn.active { color: var(--text); background: rgba(56,139,253,.14); }
    .cfg-nav-section-btn:focus-visible { outline: 2px solid var(--blue); outline-offset: -2px; }
    .openliga-feed-hidden { display: none !important; }
    #cfgCard .cfg-search-hidden { display: none !important; }
    .cfg-search-input {
      width: 100%;
      margin: 8px 0;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      font: 12px 'SFMono-Regular', Consolas, monospace;
      padding: 8px 10px;
      outline: none;
    }
    .cfg-search-input:focus { border-color: var(--blue); }
    .cfg-search-status { min-height: 16px; color: var(--muted); font-size: 11px; }
    .cfg-panels {
      display: grid;
      gap: 12px;
    }
    .cfg-pane-card {
      border: 1px solid var(--border);
      background: linear-gradient(180deg, rgba(17,23,33,.9), rgba(17,23,33,.72));
      border-radius: 10px;
      padding: 12px;
    }
    .cfg-pane-card.hidden { display: none; }
    .cfg-pane-card.cfg-nav-mode > .cfg-pane-title,
    .cfg-pane-card.cfg-nav-mode > .cfg-section > .cfg-section-header,
    .cfg-pane-card.cfg-nav-mode > .cfg-section { display: none; }
    .cfg-pane-card.cfg-nav-mode > .cfg-section.cfg-nav-selected { display: block; }
    .cfg-pane-card.cfg-nav-mode > .cfg-section.cfg-nav-selected > .cfg-section-content,
    .cfg-pane-card.cfg-nav-mode > .cfg-section.cfg-nav-selected.open > .cfg-section-content { max-height: none; overflow: visible; }
    .cfg-pane-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--blue);
      margin-bottom: 10px;
      border-bottom: 1px solid rgba(255,255,255,.06);
      padding-bottom: 6px;
    }
    @media (max-width: 980px) {
      .cfg-layout { grid-template-columns: 220px minmax(0, 1fr); }
      .cfg-layout, .cfg-sidebar, .cfg-nav, .cfg-panels, .cfg-pane-card { min-width: 0; }
      .cfg-sidebar { position: static; max-height: calc(100vh - 24px); }
      .cfg-nav { width: 100%; flex-direction: column; flex-wrap: nowrap; }
      .cfg-nav-group { min-width: 0; max-width: 100%; flex: 0 0 auto; overflow-wrap: anywhere; }
      .cfg-nav-btn { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
      .cfg-header { flex-direction: column; align-items: flex-start; }
      #cfgStatus { margin-left: 0; margin-top: 6px; }
    }
    @media (max-width: 700px) {
      .cfg-layout { grid-template-columns: minmax(0, 1fr); }
      .cfg-sidebar { max-height: 320px; }
    }
    .cfg-field { margin-bottom: 14px; }
    .cleanup-channel-head,
    .cleanup-channel-row {
      display: grid;
      grid-template-columns: minmax(190px, 240px) minmax(180px, 1fr) 110px 110px 110px 28px;
      gap: 5px;
      align-items: center;
    }
    .cleanup-channel-head { padding: 0 2px; margin-bottom: 3px; }
    .cleanup-ch-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    @media (max-width: 700px) {
      .cleanup-channel-head,
      .cleanup-channel-row {
        grid-template-columns: minmax(140px, 1.1fr) minmax(120px, 1.3fr) repeat(3, minmax(76px, .7fr)) 28px;
      }
    }
    @media (max-width: 540px) {
      .cleanup-channel-head { display: none; }
      .cleanup-channel-row { grid-template-columns: repeat(3, minmax(0, 1fr)) 28px; }
      .cleanup-ch-id { grid-column: 1 / span 2; grid-row: 1; }
      .cleanup-ch-name { grid-column: 3; grid-row: 1; }
      .cleanup-sel-mm { grid-column: 1; grid-row: 2; }
      .cleanup-sel-ma { grid-column: 2; grid-row: 2; }
      .cleanup-sel-iv { grid-column: 3; grid-row: 2; }
      .cleanup-row-remove { grid-column: 4; grid-row: 1; }
    }
    /* ── Collapsible Sections ─────────────────────────────────────────────── */
    .cfg-section { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .cfg-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(135deg, var(--surface2) 0%, rgba(255,255,255,.02) 100%);
      padding: 12px 14px;
      cursor: pointer;
      border-bottom: 1px solid var(--border);
      user-select: none;
      transition: background 0.15s ease;
    }
    .cfg-section-header:hover { background: linear-gradient(135deg, rgba(255,255,255,.06) 0%, rgba(255,255,255,.03) 100%); }
    .cfg-section-header:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
    .cfg-section-header-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: var(--text);
      font-size: 13px;
    }
    .cfg-section-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      color: var(--muted);
      transition: transform 0.2s ease;
      font-size: 12px;
    }
    .cfg-section.open .cfg-section-toggle { transform: rotate(180deg); }
    .cfg-section-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .cfg-section.open .cfg-section-content { max-height: 4000px; }
    .cfg-section-body { padding: 14px; }
    .cfg-section-body .cfg-field:last-child { margin-bottom: 0; }
    .cfg-label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .cfg-input {
      width: 100%;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      font-family: 'SFMono-Regular', Consolas, monospace;
      font-size: 12px;
      padding: 8px 10px;
      box-sizing: border-box;
      outline: none;
      transition: border-color .15s;
    }
    .cfg-input:focus { border-color: var(--blue); }
    .cfg-input.cfg-dirty {
      border-color: var(--yellow, #d4b60d);
      box-shadow: 0 0 0 1px rgba(212,182,13,.25);
    }
    #cfgCard input[type="checkbox"].cfg-dirty {
      outline: 1px solid rgba(212,182,13,.65);
      outline-offset: 2px;
    }
    .cfg-field-dirty .cfg-label {
      color: var(--yellow, #d4b60d);
    }
    .cfg-hint { font-size: 11px; color: var(--muted); margin-top: 4px; }
    .cfg-inline-action {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 8px;
      align-items: center;
    }
    .cfg-inline-action .cfg-input { flex: 1; min-width: 220px; }
    .cfg-inline-action .btn { white-space: nowrap; }
    .cfg-header {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 12px;
      padding: 10px 12px;
      background: linear-gradient(180deg, rgba(17,23,33,.95), rgba(17,23,33,.85));
      border: 1px solid var(--border);
      border-radius: 10px;
      position: sticky;
      top: 0;
      z-index: 100;
      flex-wrap: wrap;
    }
    .cfg-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; flex: 1; }
    #cfgStatus { font-size: 12px; margin-left: auto; white-space: nowrap; }
    #cfgStatus.ok  { color: var(--green); }
    #cfgStatus.err { color: var(--red); }
    #cfgStatus.warn { color: var(--yellow, #d4b60d); }
    #cfgDirtyState {
      display: none;
      font-size: 12px;
      color: var(--yellow, #d4b60d);
      white-space: nowrap;
    }
    #cfgDirtyState.show { display: inline; }
    #cfgDirtyDetailsToggle {
      display: none;
      font-size: 11px;
      padding: 5px 8px;
    }
    #cfgDirtyDetailsToggle.show { display: inline-block; }
    #cfgDirtyDetails {
      display: none;
      flex-basis: 100%;
      max-height: 220px;
      overflow: auto;
      margin-top: 2px;
      padding: 8px 10px;
      border: 1px solid rgba(212,182,13,.35);
      border-radius: 6px;
      background: rgba(212,182,13,.05);
      font-size: 11px;
    }
    #cfgDirtyDetails.show { display: block; }
    #cfgDirtyDetails ul { margin: 0; padding-left: 18px; }
    #cfgDirtyDetails li { margin: 3px 0; }
    #cfgDirtyDetails code { color: var(--muted); }

    .diag-hints { margin-top: 10px; }
    .diag-hints .ll { border-left: 2px solid transparent; padding-left: 8px; }
    .diag-hints .ll.e { border-left-color: var(--red); }
    .diag-hints .ll.w { border-left-color: var(--yellow); }
    .diag-hints .ll.i { border-left-color: var(--blue); }
  </style>
</head>
<body>

<!-- ── UPDATE BANNER (wird per JS eingeblendet) ─────── -->
<!-- ── HEADER ─────────────────────────────────────────── -->
<div class="header">
  <div>
    <h1>🤖 Bockis Bot · Dashboard</h1>
    <div class="sub" id="headerSub">Service Monitor · Live-Ansicht</div>
  </div>
  
  <!-- ── SUBNAV IN HEADER ─────────────────────────────── -->
  <div class="subnav">
    <button class="subnav-btn active" data-pane-btn="overview" onclick="setActivePane('overview')" title="Live-Übersicht: Bot, System, Services">📊 Übersicht</button>
    <button class="subnav-btn" data-pane-btn="settings" onclick="setActivePane('settings')" title="Konfiguration & Service-Steuerung">⚙️ Einstellungen</button>
    <button class="subnav-btn" data-pane-btn="updates" onclick="setActivePane('updates')" title="Updates & Git-Commits">📦 Updates</button>
    <button class="subnav-btn" data-pane-btn="diagnostics" onclick="setActivePane('diagnostics')" title="Logs & Link-Preview-Diagnose">🧪 Diagnose</button>
  </div>
  
  <div class="header-right" data-pane="overview">
    <select id="refreshIntervalSelect" onchange="setRefreshInterval(this.value)" title="Auto-Refresh Intervall" style="background:var(--surface2);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:4px 8px;font-size:13px;cursor:pointer">
      <option value="0">↺ Aus</option>
      <option value="15">15s</option>
      <option value="30">30s</option>
      <option value="60">1 Min</option>
      <option value="120">2 Min</option>
      <option value="300">5 Min</option>
    </select>
    <span class="timer" id="timer">Auto-Refresh in 30s</span>
    <button class="btn btn-green" id="btnRefresh" onclick="manualRefresh()">
      ↺ Discord Refresh
    </button>
  </div>
  <form action="/logout" method="post" style="position:relative;z-index:11;margin-left:auto">
    <button class="btn" type="submit">Abmelden</button>
  </form>
</div>

<!-- ── UPDATE BANNER ─────────────────────────────────── -->
<div id="updateBanner" class="hidden" data-pane="updates">
  <div class="ub-left">
    <span class="ub-icon">⚠️</span>
    <div>
      <div class="ub-title" id="ubTitle">Update verfügbar</div>
      <div class="ub-sub" id="ubSub">Neue Version auf GitHub gefunden</div>
    </div>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <button class="btn" onclick="toggleUpdateSection()">Details anzeigen ↓</button>
    <button class="btn btn-green" id="btnUpdateRun" onclick="runUpdate(null, 'git', 'btnUpdateRun')">▶ Git Pull starten</button>
    <button class="btn btn-green hidden" id="btnBannerNpm" onclick="runUpdate(null, 'npm', 'btnBannerNpm')">📦 npm Updates installieren</button>
  </div>
</div>

<!-- ── DASHBOARD GRID ───────────────────────────────── -->
<div class="dashboard-grid" id="dashboardGrid">

<!-- ── BOT STATUS ─────────────────────────────────────── -->
<div class="card" id="botCard" data-span="6" data-pane="overview">
  <div class="card-title">Bot Status</div>
  <div id="botInfo">
    <div class="sk"></div>
    <div class="sk" style="width:70%"></div>
    <div class="sk" style="width:50%"></div>
  </div>
</div>

<!-- ── SYSTEM ─────────────────────────────────────────── -->
<div class="card" id="sysCard" data-span="6" data-pane="overview">
  <div class="card-title">System</div>
  <div id="sysInfo">
    <div class="sk"></div>
    <div class="sk" style="width:70%"></div>
    <div class="sk" style="width:50%"></div>
  </div>
</div>

<!-- ── HARDWARE-METRIKEN ───────────────────────────────── -->
<div class="card" id="hwMetricsCard" data-span="12" data-pane="overview">
  <div class="card-title">🖥️ Hardware-Metriken</div>
  <div class="metric-grid" id="hwMetricGrid">
    <!-- CPU % -->
    <div class="metric-tile" id="mtCpuPct">
      <span class="metric-icon">⚡</span>
      <span class="metric-label">CPU Auslastung</span>
      <span class="metric-value metric-na" id="mtCpuPctVal">…</span>
      <div class="metric-bar-wrap"><div class="metric-bar ok" id="mtCpuPctBar" style="width:0%"></div></div>
      <span class="metric-sub" id="mtCpuPctSub"></span>
    </div>
    <!-- RAM -->
    <div class="metric-tile" id="mtRam">
      <span class="metric-icon">🧠</span>
      <span class="metric-label">RAM</span>
      <span class="metric-value" id="mtRamVal">…</span>
      <div class="metric-bar-wrap"><div class="metric-bar ok" id="mtRamBar" style="width:0%"></div></div>
      <span class="metric-sub" id="mtRamSub"></span>
    </div>
    <!-- CPU Temperatur -->
    <div class="metric-tile" id="mtCpuTemp">
      <span class="metric-icon">🌡️</span>
      <span class="metric-label">CPU Temperatur</span>
      <span class="metric-value" id="mtCpuTempVal">…</span>
      <div class="metric-bar-wrap"><div class="metric-bar ok" id="mtCpuTempBar" style="width:0%"></div></div>
      <span class="metric-sub" id="mtCpuTempSub"></span>
    </div>
    <!-- GPU Temperatur -->
    <div class="metric-tile" id="mtGpuTemp">
      <span class="metric-icon">🎮</span>
      <span class="metric-label">GPU Temperatur</span>
      <span class="metric-value" id="mtGpuTempVal">…</span>
      <div class="metric-bar-wrap"><div class="metric-bar ok" id="mtGpuTempBar" style="width:0%"></div></div>
      <span class="metric-sub" id="mtGpuTempSub"></span>
    </div>
    <!-- Netzwerk -->
    <div class="metric-tile" id="mtNet">
      <span class="metric-icon">🌐</span>
      <span class="metric-label">Netzwerk</span>
      <span class="metric-value" id="mtNetDown">…</span>
      <span class="metric-sub" id="mtNetDownSub">↓ Download</span>
      <span class="metric-value" id="mtNetUp" style="margin-top:4px">…</span>
      <span class="metric-sub" id="mtNetUpSub">↑ Upload</span>
    </div>
    <!-- Disk -->
    <div class="metric-tile" id="mtDisk">
      <span class="metric-icon">💾</span>
      <span class="metric-label">Festplatte</span>
      <span class="metric-value" id="mtDiskVal">…</span>
      <div class="metric-bar-wrap"><div class="metric-bar ok" id="mtDiskBar" style="width:0%"></div></div>
      <span class="metric-sub" id="mtDiskSub"></span>
    </div>
  </div>
</div>

<!-- ── ROW 1b: CLOUDFLARE TUNNEL ─────────────────────── -->
<div class="card" id="tunnelCard" data-span="12" data-pane="overview">
  <div class="card-title">🌐 Cloudflare Tunnel</div>
  <div id="tunnelInfo">
    <div class="sk"></div>
    <div class="sk" style="width:55%"></div>
  </div>
</div>

<!-- ── ROW 1d: SERVICE-ERKENNUNG ─────────────────────── -->
<div class="card" id="containersCard" data-span="12" data-pane="overview">
  <div class="card-title">🐳 Service-Erkennung</div>
  <div id="containersInfo">
    <div class="sk"></div>
    <div class="sk" style="width:66%"></div>
  </div>
</div>

<!-- ── ROW 1c: DISCORD KONFIGURATION ───────────────────── -->
<div class="card" id="cfgCard" data-span="12" data-pane="settings">
  <div class="card-title">⚙️ Einstellungen</div>
  <div class="cfg-form">
    <div class="cfg-layout">
      <div class="cfg-sidebar">
        <div class="cfg-sidebar-title">Einstellungs-Menü</div>
        <label class="cfg-label" for="cfgSettingsSearch">Einstellungen suchen</label>
        <input class="cfg-search-input" id="cfgSettingsSearch" type="search" autocomplete="off" placeholder="Name, Option oder Bereich" oninput="filterSettings(this.value)">
        <div class="cfg-search-status" id="cfgSettingsSearchStatus" aria-live="polite"></div>
        <div class="cfg-nav">
          <button class="cfg-nav-btn active" data-cfg-pane-btn="bot" onclick="setActiveSettingsPane('bot')">🤖 Bot & IDs</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="commands" onclick="setActiveSettingsPane('commands')">⌨️ Bot-Kommandos</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="channels" onclick="setActiveSettingsPane('channels')">🧩 Dienst-Kanäle</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="renderer" onclick="setActiveSettingsPane('renderer')">📡 Status-Renderer</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="security" onclick="setActiveSettingsPane('security')">🗂 Sicherheit & API</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="raspi" onclick="setActiveSettingsPane('raspi')">🍓 Raspi & Web</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="welcome" onclick="setActiveSettingsPane('welcome')">👋 Willkommen & Auto-Reply</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="openligadb" onclick="setActiveSettingsPane('openligadb')">⚽ OpenLigaDB</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="github" onclick="setActiveSettingsPane('github')">🐙 GitHub-Watcher</button>
          <button class="cfg-nav-btn" data-cfg-pane-btn="aichat" onclick="setActiveSettingsPane('aichat')">🤖 KI-Chat (OpenAI)</button>
        </div>
      </div>

      <div class="cfg-panels">
        <div class="cfg-header">
          <div class="cfg-actions">
            <label class="cfg-label" for="serverProfileSelect">Discord-Server</label>
            <select class="cfg-input" id="serverProfileSelect" onchange="switchServerProfile(this.value)" aria-label="Serverprofil auswählen">
              <option value="">Serverprofile werden geladen …</option>
            </select>
            <button class="btn" id="btnCreateServerProfile" type="button" onclick="toggleServerProfileCreate()">＋ Profil erstellen</button>
            <div id="serverProfileCreateControls" hidden>
              <select class="cfg-input" id="serverProfileCreateGuild" onchange="fillServerProfileGuild(this.value)" aria-label="Discord-Server für neues Profil auswählen">
                <option value="">Server auswählen …</option>
              </select>
              <input class="cfg-input" id="serverProfileCreateGuildId" type="text" inputmode="numeric" autocomplete="off" placeholder="Discord-Guild-ID">
              <input class="cfg-input" id="serverProfileCreateGuildName" type="text" maxlength="100" autocomplete="off" placeholder="Servername (Pflicht, falls nicht beigetreten)">
              <button class="btn btn-green" id="btnConfirmCreateServerProfile" type="button" onclick="createServerProfile()">Anlegen</button>
              <button class="btn" type="button" onclick="toggleServerProfileCreate(false)">Abbrechen</button>
            </div>
            <button class="btn btn-green" id="btnCfgSave" onclick="saveConfig()">💾 Speichern &amp; Neu starten</button>
            <button class="btn" onclick="confirmResetConfig()" title="Lädt alle Eingaben aus der gespeicherten Konfiguration neu">↺ Zurücksetzen</button>
            <span id="cfgDirtyState" title="Ungespeicherte lokale Änderungen in den Einstellungen">● Ungespeicherte Änderungen</span>
            <button class="btn" id="cfgDirtyDetailsToggle" type="button" onclick="toggleConfigDirtyDetails()">Änderungen anzeigen</button>
            <div id="cfgDirtyDetails" aria-live="polite"></div>
          </div>
          <span id="cfgStatus"></span>
        </div>
      <div class="cfg-pane-card" data-cfg-pane="bot">
        <div class="cfg-pane-title">🤖 Bot & IDs</div>
        <!-- Token & IDs Section -->
        <div class="cfg-section open">
          <div class="cfg-section-header" onclick="toggleConfigSection(this)">
            <div class="cfg-section-header-title">
              <span class="cfg-section-toggle">▾</span>
              <span>🔑 Token & IDs</span>
            </div>
          </div>
          <div class="cfg-section-content">
            <div class="cfg-section-body">
              <div class="cfg-field">
                <label class="cfg-label" for="cfgToken">Discord Bot Token <span class="badge warn">Pflichtfeld</span></label>
                <div style="position:relative">
                  <input class="cfg-input" id="cfgToken" type="password" autocomplete="off"
                         placeholder="Token HIER eingeben (beim ersten Mal Pflicht!)"
                         style="padding-right: 44px">
                  <button type="button" class="btn-icon" data-for="cfgToken" onclick="window.togglePassword('cfgToken')" 
                          style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;padding:4px"
                          aria-label="Token anzeigen/verstecken">👁</button>
                </div>
                <div class="cfg-hint warn">⚠️ Beim ersten Setup: Token HIER eintragen! Leer lassen behält nur einen bereits gespeicherten Token. Platzhalter "dein_discord_bot_token_hier" funktioniert NICHT.</div>
              </div>
              <div class="cfg-field">
                <label class="cfg-label" for="cfgBotName">Discord Bot Name</label>
                <input class="cfg-input" id="cfgBotName" type="text" autocomplete="off"
                       placeholder="z. B. Uptime-Bot">
                <div class="cfg-hint">Wird beim nächsten Bot-Start als Discord-Username gesetzt (max. 32 Zeichen).</div>
              </div>
              <div class="cfg-field">
                <label class="cfg-label" for="cfgGuildId">Guild ID</label>
                <input class="cfg-input" id="cfgGuildId" type="text" autocomplete="off"
                       placeholder="z. B. 123456789012345678">
              </div>
            </div>
          </div>
        </div>
        <!-- Präsenz & Status Section -->
        <div class="cfg-section open">
          <div class="cfg-section-header" onclick="toggleConfigSection(this)">
            <div class="cfg-section-header-title">
              <span class="cfg-section-toggle">▾</span>
              <span>😎 Präsenz & Status</span>
            </div>
          </div>
          <div class="cfg-section-content">
            <div class="cfg-section-body">
              <div class="cfg-field">
                <label class="cfg-label" for="cfgPresenceText">Discord "Schaut zu" Texte</label>
                <input class="cfg-input" id="cfgPresenceText" type="text" autocomplete="off"
                       placeholder="Service Health;den Serverstatus;neue Updates">
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
                  <select class="cfg-input" id="cfgPresencePreset" style="min-width:220px;flex:1">
                    <option value="">Lustige Vorlage wählen…</option>
