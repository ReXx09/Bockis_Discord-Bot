        st.textContent = `✓ Gespeichert: ${res.updated.join(', ')}${res.restartId ? ' · Bot startet neu…' : ''}`;
        st.className = 'ok';
        toast('✓ Konfiguration gespeichert', 'ok');
        
        // Bot-Polling nach Restart vornehmen
        if (res.restartId) {
          st.textContent += ' ⏳ Warte auf Bot-Neustart…';
          btn.textContent = '⏳ Bot startet neu…';
          btn.disabled = true;
          
          let pollBotReady = null;
          let pollInFlight = false;
          let pollingFinished = false;
          const deadline = Date.now() + 90000;

          const fetchJsonWithTimeout = async (url) => {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 3000);
            try {
              const response = await fetch(url, { signal: controller.signal });
              return { response, data: await response.json() };
            } finally {
              clearTimeout(timeout);
            }
          };
          
          const cleanupPolling = (success, message = '') => {
            if (pollingFinished) return;
            pollingFinished = true;
            if (pollBotReady) {
              clearInterval(pollBotReady);
              pollBotReady = null;
            }
            btn.disabled = false;
            btn.textContent = configSaveButtonLabel();
            if (success) {
              clearConfigDirtyTracking();
              loadConfig({ force: true }).then(() => {
                initConfigDirtyTracking(); // Listener wieder registrieren
              });
              fetchAll();
              fetch('/api/refresh', { method: 'POST' }).catch(() => {});
              st.textContent = `✓ Bot neu gestartet. Status aktualisiert.`;
              st.className = 'ok';
            } else {
              st.textContent = message || '⚠ Bot-Neustart konnte nicht bestätigt werden.';
              st.className = 'warn';
            }
          };
          
          pollBotReady = setInterval(async () => {
            if (pollInFlight) return;
            if (Date.now() >= deadline) {
              cleanupPolling(false, '⚠ Bot-Neustart nach 90s nicht bestätigt. Bitte Status manuell prüfen.');
              return;
            }
            pollInFlight = true;
            try {
              const restartUrl = `/api/restart-status?id=${encodeURIComponent(res.restartId)}`;
              const restart = await fetchJsonWithTimeout(restartUrl);
              if (restart.data.ok && restart.data.status === 'failed') {
                cleanupPolling(false, `⚠ Neustart fehlgeschlagen: ${restart.data.error || 'Unbekannter Fehler'}`);
                return;
              }
              const restartedProcess = restart.data.status === 'success'
                || (!restart.data.ok && restart.data.error === 'Unbekannte restartId');
              if (restart.response.ok && restartedProcess) {
                const config = await fetchJsonWithTimeout('/api/config');
                if (config.response.ok && config.data.ok === true) cleanupPolling(true);
              }
            } catch {
              // Während des Service-Neustarts ist die Verbindung kurz nicht verfügbar.
            } finally {
              pollInFlight = false;
              if (Date.now() >= deadline) {
                cleanupPolling(false, '⚠ Bot-Neustart nach 90s nicht bestätigt. Bitte Status manuell prüfen.');
              }
            }
          }, 1000);
        } else {
          clearConfigDirtyTracking();
          loadConfig({ force: true }).then(() => {
            initConfigDirtyTracking(); // Listener wieder registrieren
          });
        }
      } else {
        st.textContent = '✗ ' + (res.error || 'Unbekannter Fehler');
        st.className = 'err';
        toast('Fehler: ' + res.error, 'err');
        btn.disabled = false;
        btn.textContent = configSaveButtonLabel();
      }
    } catch (e) {
      st.textContent = 'Verbindungsfehler: ' + e.message;
      st.className = 'err';
      toast('Verbindungsfehler', 'err');
      btn.disabled = false;
      btn.textContent = configSaveButtonLabel();
    } finally {
      // Sicherheitsnetz: Button NIEMALS dauerhaft disabled lassen
      if (btn.disabled && !res?.restarted) {
        btn.disabled = false;
        btn.textContent = configSaveButtonLabel();
      }
      // Listener sicherstellen (falls loadConfig durchlief aber initConfigDirtyTracking fehlte)
      if (!btn.disabled) {
        initConfigDirtyTracking();
      }
    }
  }

