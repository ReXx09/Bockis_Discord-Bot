  function maybeSetChanged(body, key, id, { allowEmpty = false } = {}) {
    const el = document.getElementById(id);
    if (!el) return;
    const value = el.value.trim();
    const initial = (el.dataset.initialValue || '').trim();
    // Spezialbehandlung für Token: immer senden wenn Wert eingegeben (auch wenn initial __MASKED__)
    if (key === 'DISCORD_TOKEN' && value && value !== initial) {
      body[key] = value;
      return;
    }
    if (value === initial) return;
    if (!allowEmpty && !value) return;
    body[key] = value;
  }

  // Explizit global für onclick-Handler
  window.togglePassword = function(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.type = el.type === 'password' ? 'text' : 'password';
    // Button robust suchen: nächster Element-Sibling ODER Button mit data-for
    let btn = el.nextElementSibling;
    if (!btn || btn.tagName !== 'BUTTON') {
      btn = document.querySelector(`button[data-for="${id}"]`);
    }
    if (btn) btn.textContent = el.type === 'password' ? '👁' : '🙈';
  };

  function maybeSetChangedAny(body, key, ids, { allowEmpty = false } = {}) {
    for (const id of ids) {
      const el = document.getElementById(id);
      if (!el) continue;
      const value = el.value.trim();
      const initial = (el.dataset.initialValue || '').trim();
      if (value === initial) continue;
      if (!allowEmpty && !value) continue;
      body[key] = value;
      return;
    }
  }

