  async function waitForOpenLigaDbRestart(restartId) {
    const deadline = Date.now() + 90_000;
    const fetchJsonWithTimeout = async (url) => {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 3000);
      try {
        const response = await fetch(url, { signal: controller.signal });
        return { response, data: await response.json() };
      } finally {
        clearTimeout(timeout);
      }
    };

    while (Date.now() < deadline) {
      try {
        const restart = await fetchJsonWithTimeout(`/api/restart-status?id=${encodeURIComponent(restartId)}`);
        if (restart.data.ok && restart.data.status === 'failed') {
          throw new Error(`Neustart fehlgeschlagen: ${restart.data.error || 'Unbekannter Fehler'}`);
        }
        if (restart.response.ok
          && (restart.data.status === 'success' || (!restart.data.ok && restart.data.error === 'Unbekannte restartId'))) {
          return true;
        }
      } catch (error) {
        if (error.message.startsWith('Neustart fehlgeschlagen:')) throw error;
        if (error.name !== 'AbortError' && !(error instanceof TypeError)) throw error;
        // Während des Service-Neustarts kann die Verbindung vorübergehend ausfallen.
      }
      await new Promise(resolve => setTimeout(resolve, 1000));
    }
    return false;
  }

  async function saveOpenLigaDbSettings() {
    const invalidUpdateInterval = Array.from(document.querySelectorAll('#cfgOpenLigaDbFeeds [data-openliga-role="update-interval"]'))
      .find(input => !input.checkValidity());
    if (invalidUpdateInterval) {
      const feedRow = invalidUpdateInterval.closest('[data-openliga-feed]');
      if (feedRow) selectOpenLigaDbFeed(feedRow.dataset.openligaFeedId);
      invalidUpdateInterval.reportValidity();
      return;
    }

    const button = document.getElementById('btnOpenLigaDbSave');
    const status = document.getElementById('cfgOpenLigaDbSaveStatus');
    button.disabled = true;
    button.textContent = '⏳ OpenLigaDB wird gespeichert…';
    status.textContent = '';
    status.className = 'cfg-hint';

    try {
      const body = {};
      const enabled = document.getElementById('cfgOpenLigaDbEnabled');
      const enabledValue = enabled.checked ? 'true' : 'false';
      if (enabledValue !== (enabled.dataset.initialValue || 'false')) {
        body.DISCORD_OPENLIGADB_ENABLED = enabledValue;
      }
      const feedsValue = JSON.stringify(serializeOpenLigaDbFeeds());
      const feedsField = document.getElementById('cfgOpenLigaDbFeedsValue');
      if (feedsValue !== (feedsField.dataset.initialValue || '[]')) {
        body.DISCORD_OPENLIGADB_FEEDS = feedsValue;
      }

      if (!Object.keys(body).length) {
        status.textContent = 'Keine OpenLigaDB-Änderungen erkannt.';
        status.className = 'cfg-hint warn';
        return;
      }

      const response = activeServerProfileGuildId
        ? await fetch(`/api/server-profiles/${encodeURIComponent(activeServerProfileGuildId)}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ settings: body }),
        }).then(result => result.json())
        : await fetch('/api/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        }).then(result => result.json());

      if (!response.ok) throw new Error(response.error || 'OpenLigaDB-Einstellungen konnten nicht gespeichert werden.');
      markOpenLigaDbSettingsSaved();

      if (activeServerProfileGuildId) {
        status.textContent = '✓ OpenLigaDB-Einstellungen im Serverprofil gespeichert.';
        status.className = 'cfg-hint ok';
        toast('✓ OpenLigaDB-Einstellungen gespeichert', 'ok');
        return;
      }

      if (response.restartId) {
        status.textContent = '✓ OpenLigaDB-Einstellungen gespeichert. Bot startet neu …';
        status.className = 'cfg-hint';
        const restarted = await waitForOpenLigaDbRestart(response.restartId);
        if (restarted) {
          status.textContent = '✓ OpenLigaDB-Einstellungen gespeichert; Bot wurde neu gestartet.';
          status.className = 'cfg-hint ok';
        } else {
          status.textContent = 'OpenLigaDB-Einstellungen sind gespeichert, aber der Bot-Neustart konnte nicht bestätigt werden.';
          status.className = 'cfg-hint warn';
        }
      } else {
        status.textContent = '✓ OpenLigaDB-Einstellungen gespeichert.';
        status.className = 'cfg-hint ok';
      }
      toast('✓ OpenLigaDB-Einstellungen gespeichert', 'ok');
    } catch (error) {
      status.textContent = `✗ ${error.message}`;
      status.className = 'cfg-hint err';
      toast(`Fehler: ${error.message}`, 'err');
    } finally {
      button.disabled = false;
      button.textContent = '💾 OpenLigaDB speichern';
    }
  }

