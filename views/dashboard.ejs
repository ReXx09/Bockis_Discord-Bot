  function updateTranslateProviderStatus() {
    const statusEl = document.getElementById('cfgTranslateProviderStatus');
    const providerEl = document.getElementById('cfgTranslateProvider');
    const helpEl = document.getElementById('cfgTranslateProviderHelp');
    const deepLConfigEl = document.getElementById('cfgTranslateDeepLConfig');
    const libreConfigEl = document.getElementById('cfgTranslateLibreConfig');
    const deepLKeyEl = document.getElementById('cfgDeepLApiKey');
    const libreUrlEl = document.getElementById('cfgTranslateApiUrl');
    const openAIKeyEl = document.getElementById('cfgOpenaiApiKey');
    if (!statusEl || !providerEl || !helpEl || !deepLConfigEl || !libreConfigEl || !deepLKeyEl || !libreUrlEl || !openAIKeyEl) return;

    const provider = providerEl.value || 'auto';
    const hasDeepLKey = !!String(deepLKeyEl.value || '').trim() || deepLKeyEl.dataset.initialValue === '__MASKED__';
    const hasOpenAIKey = !!String(openAIKeyEl.value || '').trim()
      || openAIKeyEl.dataset.initialValue === '__MASKED__'
      || /gesetzt/i.test(openAIKeyEl.placeholder);
    const libreUrl = String(libreUrlEl.value || '').trim() || 'http://localhost:5000/translate';

    deepLConfigEl.style.display = provider === 'deepl' ? '' : 'none';
    libreConfigEl.style.display = provider === 'openai' ? 'none' : '';
    if (provider === 'auto') {
      helpEl.textContent = 'Kein DeepL erforderlich. OpenAI wird bevorzugt, LibreTranslate dient als Fallback.';
      statusEl.textContent = hasOpenAIKey
        ? 'Bereit: OpenAI ist konfiguriert; bei Fehlern wird LibreTranslate unter ' + libreUrl + ' genutzt.'
        : 'OpenAI-Key fehlt: LibreTranslate unter ' + libreUrl + ' wird verwendet.';
    } else if (provider === 'openai') {
      helpEl.textContent = 'Verwendet den OpenAI-Key aus dem Bereich KI-Chat. Kein DeepL-Key erforderlich.';
      statusEl.textContent = hasOpenAIKey ? 'Bereit: OpenAI wird als Übersetzer verwendet.' : 'OpenAI-Key fehlt. Hinterlege ihn im Bereich KI-Chat.';
    } else if (provider === 'deepl') {
      helpEl.textContent = 'DeepL benötigt einen eigenen API-Key; bei fehlendem Key oder Fehler wird LibreTranslate genutzt.';
      statusEl.textContent = hasDeepLKey
        ? 'Bereit: DeepL wird verwendet; Fallback: LibreTranslate unter ' + libreUrl + '.'
        : 'DeepL-Key fehlt. Fallback: LibreTranslate unter ' + libreUrl + '.';
    } else {
      helpEl.textContent = 'Verwendet ausschließlich LibreTranslate. DeepL und OpenAI werden nicht benötigt.';
      statusEl.textContent = 'LibreTranslate wird unter ' + libreUrl + ' verwendet.';
    }
  }

  function _parseEnabledCommands(value) {
    const defaults = Array.from(document.querySelectorAll('[data-cmd]')).map((el) => String(el.dataset.cmd || '').trim()).filter(Boolean);
    const entries = String(value || '')
      .split(',')
      .map(s => s.trim().toLowerCase())
      .filter(Boolean);
    const unique = Array.from(new Set(entries));
    return unique.length ? unique : defaults;
  }

  // ── Discord-Kanal-Browser für Mapping-Übernahme ──────────────────────────
  let _existingCategoryData = [];
  let _existingUncategorized = [];

  function _renderExistingChannelSelect() {
    const categoryEl = document.getElementById('cfgExistingCategorySelect');
    const channelEl = document.getElementById('cfgExistingChannelSelect');
    if (!categoryEl || !channelEl) return;

    const selectedCategoryId = categoryEl.value || '__uncategorized__';
    let channels = [];

    if (selectedCategoryId === '__uncategorized__') {
      channels = _existingUncategorized;
    } else {
      channels = (_existingCategoryData.find(c => c.id === selectedCategoryId)?.channels) || [];
    }

    channelEl.innerHTML = '<option value="">Kanal auswählen…</option>';
    channels.forEach((ch) => {
      const opt = document.createElement('option');
      opt.value = ch.id;
      opt.textContent = `# ${ch.name}`;
      channelEl.appendChild(opt);
    });
  }

  async function loadExistingGuildChannels() {
    const btn = document.getElementById('btnLoadExistingChannels');
    const state = document.getElementById('cfgExistingChannelState');
    const categoryEl = document.getElementById('cfgExistingCategorySelect');

    const serviceGuild = (document.getElementById('cfgServiceGuildId')?.value || '').trim();
    const defaultGuild = (document.getElementById('cfgGuildId')?.value || '').trim();
    const guildId = serviceGuild || defaultGuild;

    if (!guildId) {
      if (state) state.textContent = 'Bitte zuerst SERVICE_GUILD_ID oder GUILD_ID setzen.';
      toast('Guild-ID fehlt', 'warn');
      return;
    }

    if (btn) { btn.disabled = true; btn.textContent = '⏳ Lade…'; }
    if (state) state.textContent = 'Lade Kategorien und Kanäle aus Discord…';

    try {
      const d = await fetch(`/api/discord-channel-browser?guildId=${encodeURIComponent(guildId)}`).then(r => r.json());
      if (!d.ok) {
        if (state) state.textContent = 'Fehler: ' + (d.error || 'Unbekannt');
        toast('Discord-Kanäle laden fehlgeschlagen', 'err');
        return;
      }

      _existingCategoryData = d.categories || [];
      _existingUncategorized = d.uncategorized || [];

      categoryEl.innerHTML = '<option value="">Kategorie auswählen…</option>';
      _existingCategoryData.forEach((cat) => {
        const opt = document.createElement('option');
        opt.value = cat.id;
        opt.textContent = `${cat.name} (${cat.channels?.length || 0})`;
        categoryEl.appendChild(opt);
      });
      if (_existingUncategorized.length) {
        const opt = document.createElement('option');
        opt.value = '__uncategorized__';
        opt.textContent = `Ohne Kategorie (${_existingUncategorized.length})`;
        categoryEl.appendChild(opt);
      }

      categoryEl.onchange = _renderExistingChannelSelect;
      _renderExistingChannelSelect();

      if (state) state.textContent = `Geladen: ${d.guild?.name || guildId} · ${_existingCategoryData.length} Kategorien`;
      toast('Kategorien/Kanäle geladen', 'ok');
    } catch (e) {
      if (state) state.textContent = 'Verbindungsfehler: ' + e.message;
      toast('Verbindungsfehler beim Laden', 'err');
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = '🔎 Aus Discord laden'; }
    }
  }

  function addSelectedChannelToMap() {
    const monitorEl = document.getElementById('cfgExistingMonitorName');
    const channelEl = document.getElementById('cfgExistingChannelSelect');
    const mapEl = document.getElementById('cfgServiceChannelMap');
    const state = document.getElementById('cfgExistingChannelState');

    const monitorName = String(monitorEl?.value || '').trim();
    const channelId = String(channelEl?.value || '').trim();
    if (!monitorName) {
      toast('Monitorname fehlt', 'warn');
      return;
    }
    if (!channelId) {
      toast('Kanal fehlt', 'warn');
      return;
    }

    const current = String(mapEl?.value || '').trim();
    const entries = current ? current.split(';').map(s => s.trim()).filter(Boolean) : [];
    const normalizedMonitor = monitorName.toLowerCase();

    const filtered = entries.filter((entry) => {
      const idx = entry.lastIndexOf('=');
      if (idx <= 0) return true;
      const left = entry.slice(0, idx).trim().toLowerCase();
      return left !== normalizedMonitor;
    });

    filtered.push(`${monitorName}=${channelId}`);
    mapEl.value = filtered.join(';');

    if (state) state.textContent = `Mapping aktualisiert: ${monitorName} → ${channelId}`;
    toast('Kanal ins Mapping übernommen', 'ok');
  }

  function applyEnabledCommandsToCheckboxes(value) {
    const enabled = new Set(_parseEnabledCommands(value));
    const boxes = document.querySelectorAll('[data-cmd]');
    boxes.forEach((box) => {
      box.checked = enabled.has(box.dataset.cmd);
    });
  }

  function syncEnabledCommandsFromCheckboxes(changedBox = null) {
    const boxes = Array.from(document.querySelectorAll('[data-cmd]'));
    if (!boxes.length) return;

    let selected = boxes.filter(b => b.checked);
    if (!selected.length) {
      if (changedBox) changedBox.checked = true;
      selected = boxes.filter(b => b.checked);
      toast('Mindestens ein Bot-Kommando muss aktiv bleiben', 'warn');
    }

    const value = selected.map(b => b.dataset.cmd).join(',');
    const hidden = document.getElementById('cfgEnabledCommands');
    if (hidden) hidden.value = value;
  }

  let _activeSettingsSection = '';
  let openLigaDbNavSectionList = null;
  let activeOpenLigaDbFeedId = '';
  let nextOpenLigaDbFeedId = 0;

  function initSettingsNavigation() {
    const nav = document.querySelector('#cfgCard .cfg-nav');
    if (!nav || nav.dataset.ready === '1') return;

    const groups = [];
    const paneButtons = Array.from(nav.querySelectorAll(':scope > .cfg-nav-btn'));
    paneButtons.forEach((paneButton) => {
      const pane = paneButton.dataset.cfgPaneBtn;
      const card = document.querySelector(`#cfgCard [data-cfg-pane="${pane}"]`);
      if (!pane || !card) return;

      const looseNodes = Array.from(card.children).filter((child) =>
        !child.matches('.cfg-pane-title, .cfg-section')
      );
      if (looseNodes.length) {
        const section = document.createElement('div');
        section.className = 'cfg-section open';
        const header = document.createElement('div');
        header.className = 'cfg-section-header';
        const headerTitle = document.createElement('div');
        headerTitle.className = 'cfg-section-header-title';
        const toggle = document.createElement('span');
        toggle.className = 'cfg-section-toggle';
        toggle.textContent = '▾';
        const title = document.createElement('span');
        title.textContent = 'Weitere Einstellungen';
        headerTitle.append(toggle, title);
        header.append(headerTitle);
        const content = document.createElement('div');
        content.className = 'cfg-section-content';
        const body = document.createElement('div');
        body.className = 'cfg-section-body';
        looseNodes.forEach((node) => body.appendChild(node));
        content.appendChild(body);
        section.append(header, content);
        card.appendChild(section);
      }

      const group = document.createElement('div');
      group.className = 'cfg-nav-group';
      const sectionList = document.createElement('div');
      sectionList.className = 'cfg-nav-sections';
      sectionList.id = `cfg-nav-sections-${pane}`;
      if (pane === 'openligadb') openLigaDbNavSectionList = sectionList;
      paneButton.type = 'button';
      paneButton.removeAttribute('onclick');
      paneButton.setAttribute('aria-controls', sectionList.id);
      paneButton.setAttribute('aria-expanded', 'false');

      card.classList.add('cfg-nav-mode');
      Array.from(card.querySelectorAll(':scope > .cfg-section')).forEach((section, index) => {
        const sectionId = `${pane}-${index}`;
        section.dataset.cfgSectionId = sectionId;
        const sectionTitle = section.querySelector('.cfg-section-header-title span:last-child')?.textContent?.trim() || 'Einstellungen';
        const sectionButton = document.createElement('button');
        sectionButton.type = 'button';
        sectionButton.className = 'cfg-nav-section-btn';
        sectionButton.dataset.cfgSectionBtn = sectionId;
        sectionButton.textContent = sectionTitle;
        sectionButton.setAttribute('aria-controls', `${sectionId}-content`);
        sectionButton.addEventListener('click', () => selectSettingsSection(pane, sectionId));
        section.querySelector('.cfg-section-content')?.setAttribute('id', `${sectionId}-content`);
        sectionList.appendChild(sectionButton);
      });

      paneButton.addEventListener('click', () => {
        if (paneButton.classList.contains('active') && group.classList.contains('open')) {
          group.classList.remove('open');
          paneButton.setAttribute('aria-expanded', 'false');
          return;
        }
        setActiveSettingsPane(pane);
        if (!card.querySelector('.cfg-nav-selected')) {
          const firstSection = card.querySelector(':scope > .cfg-section');
          if (firstSection) selectSettingsSection(pane, firstSection.dataset.cfgSectionId);
        }
      });

      group.append(paneButton, sectionList);
      groups.push(group);
    });

    nav.replaceChildren(...groups);
    nav.dataset.ready = '1';
    refreshOpenLigaDbNavigation();
    setActiveSettingsPane('bot');
    const firstSection = document.querySelector('#cfgCard [data-cfg-pane="bot"] > .cfg-section');
    if (firstSection) selectSettingsSection('bot', firstSection.dataset.cfgSectionId);
  }

  function setActiveSettingsPane(pane) {
    document.querySelectorAll('#cfgCard [data-cfg-pane-btn]').forEach((btn) => {
      const active = btn.dataset.cfgPaneBtn === pane;
      btn.classList.toggle('active', active);
      const group = btn.closest('.cfg-nav-group');
      group?.classList.toggle('open', active);
      btn.setAttribute('aria-expanded', active ? 'true' : 'false');
    });
    document.querySelectorAll('#cfgCard [data-cfg-pane]').forEach((card) => {
      card.classList.toggle('hidden', card.dataset.cfgPane !== pane);
    });
  }

  function selectSettingsSection(pane, sectionId) {
    setActiveSettingsPane(pane);
    const card = document.querySelector(`#cfgCard [data-cfg-pane="${pane}"]`);
    if (!card) return;
    card.querySelectorAll(':scope > .cfg-section').forEach((section) => {
      const selected = section.dataset.cfgSectionId === sectionId;
      section.classList.toggle('cfg-nav-selected', selected);
      section.classList.toggle('open', selected);
      section.querySelector('.cfg-section-header')?.setAttribute('aria-expanded', selected ? 'true' : 'false');
    });
    document.querySelectorAll('#cfgCard [data-cfg-section-btn]').forEach((button) => {
      button.classList.toggle('active', button.dataset.cfgSectionBtn === sectionId);
    });
    _activeSettingsSection = sectionId;
    if (pane === 'openligadb') {
      activeOpenLigaDbFeedId = '';
      updateOpenLigaDbFeedVisibility();
      refreshOpenLigaDbNavigation();
    }
  }

  function updateOpenLigaDbFeedVisibility() {
    const general = document.getElementById('cfgOpenLigaDbGeneral');
    const actions = document.getElementById('cfgOpenLigaDbActions');
    const selectedFeedId = activeOpenLigaDbFeedId;
    general?.classList.toggle('openliga-feed-hidden', !!selectedFeedId);
    actions?.classList.toggle('openliga-feed-hidden', !!selectedFeedId);
    document.querySelectorAll('#cfgOpenLigaDbFeeds [data-openliga-feed]').forEach((row) => {
      row.classList.toggle('openliga-feed-hidden', !selectedFeedId || row.dataset.openligaFeedId !== selectedFeedId);
    });
  }

  function refreshOpenLigaDbNavigation() {
    if (!openLigaDbNavSectionList) return;
    openLigaDbNavSectionList.querySelectorAll('[data-openliga-nav-feed]').forEach((button) => button.remove());
    const rows = Array.from(document.querySelectorAll('#cfgOpenLigaDbFeeds [data-openliga-feed]'));
    if (!rows.some((row) => row.dataset.openligaFeedId === activeOpenLigaDbFeedId)) activeOpenLigaDbFeedId = '';
    const searchTerm = document.getElementById('cfgSettingsSearch')?.value?.trim().toLowerCase() || '';

    rows.forEach((row) => {
      const select = row.querySelector('[data-openliga-role="league"]');
      const title = select?.selectedOptions?.[0]?.textContent?.trim()
        || row.querySelector('[data-openliga-role="title"]')?.textContent?.trim()
        || 'Liga';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'cfg-nav-section-btn';
      button.dataset.openligaNavFeed = row.dataset.openligaFeedId;
      button.textContent = title;
      button.setAttribute('aria-controls', row.id);
      button.classList.toggle('active', row.dataset.openligaFeedId === activeOpenLigaDbFeedId);
      button.classList.toggle('cfg-search-hidden', !!searchTerm && !title.toLowerCase().includes(searchTerm));
      button.addEventListener('click', () => selectOpenLigaDbFeed(row.dataset.openligaFeedId));
      openLigaDbNavSectionList.appendChild(button);
    });
  }

  function selectOpenLigaDbFeed(feedId) {
    const row = Array.from(document.querySelectorAll('#cfgOpenLigaDbFeeds [data-openliga-feed]'))
      .find((feedRow) => feedRow.dataset.openligaFeedId === feedId);
    const section = document.querySelector('#cfgCard [data-cfg-pane="openligadb"] > .cfg-section');
    if (!row || !section) return;

    selectSettingsSection('openligadb', section.dataset.cfgSectionId);
    activeOpenLigaDbFeedId = feedId;
    updateOpenLigaDbFeedVisibility();
    openLigaDbNavSectionList?.querySelectorAll('[data-cfg-section-btn]').forEach((button) => button.classList.remove('active'));
    openLigaDbNavSectionList?.querySelectorAll('[data-openliga-nav-feed]').forEach((button) => {
      button.classList.toggle('active', button.dataset.openligaNavFeed === feedId);
    });
  }

  let _settingsSearchActive = false;
  let _settingsSearchReturnPane = 'bot';
  let _settingsSearchReturnSection = '';

  function filterSettings(query) {
    const term = String(query || '').trim().toLowerCase();
    const cards = Array.from(document.querySelectorAll('#cfgCard .cfg-pane-card'));
    const navButtons = Array.from(document.querySelectorAll('#cfgCard [data-cfg-pane-btn]'));
    const sectionButtons = Array.from(document.querySelectorAll('#cfgCard [data-cfg-section-btn]'));
    const openLigaDbButtons = Array.from(document.querySelectorAll('#cfgCard [data-openliga-nav-feed]'));
    const status = document.getElementById('cfgSettingsSearchStatus');

    if (term && !_settingsSearchActive) {
      _settingsSearchReturnPane = document.querySelector('#cfgCard .cfg-nav-btn.active')?.dataset.cfgPaneBtn || 'bot';
      _settingsSearchReturnSection = _activeSettingsSection;
      _settingsSearchActive = true;
    }

    const matches = [];
    cards.forEach((card) => {
      const pane = card.dataset.cfgPane;
      const navButton = navButtons.find((button) => button.dataset.cfgPaneBtn === pane);
      const paneText = `${navButton?.textContent || ''} ${card.querySelector('.cfg-pane-title')?.textContent || ''}`.toLowerCase();
      const paneMatches = !!term && (paneText.includes(term)
        || (pane === 'openligadb' && openLigaDbButtons.some((button) => button.textContent.toLowerCase().includes(term))));
      let fieldMatches = 0;

      card.querySelectorAll('.cfg-section').forEach((section) => {
        const sectionTitle = section.querySelector('.cfg-section-header-title')?.textContent?.toLowerCase() || '';
        const sectionMatches = !term || paneMatches || sectionTitle.includes(term);
        let hasMatch = sectionMatches;
        section.querySelectorAll('.cfg-field').forEach((field) => {
          const fieldMatchesTerm = sectionMatches || field.textContent.toLowerCase().includes(term);
          field.classList.toggle('cfg-search-hidden', !!term && !fieldMatchesTerm);
          if (term && fieldMatchesTerm) fieldMatches++;
          if (fieldMatchesTerm) hasMatch = true;
        });
        section.classList.toggle('cfg-search-hidden', !!term && !hasMatch);
        const sectionButton = sectionButtons.find((button) => button.dataset.cfgSectionBtn === section.dataset.cfgSectionId);
        sectionButton?.classList.toggle('cfg-search-hidden', !!term && !hasMatch);
        if (term && hasMatch) {
          section.classList.add('open');
          section.querySelector('.cfg-section-header')?.setAttribute('aria-expanded', 'true');
        }
      });

      card.querySelectorAll('.cfg-field').forEach((field) => {
        if (field.closest('.cfg-section')) return;
        const fieldMatchesTerm = !term || paneMatches || field.textContent.toLowerCase().includes(term);
        field.classList.toggle('cfg-search-hidden', !!term && !fieldMatchesTerm);
        if (term && fieldMatchesTerm) fieldMatches++;
      });

      const paneMatchesSearch = !term || paneMatches || fieldMatches > 0;
      card.classList.toggle('cfg-search-hidden', !!term && !paneMatchesSearch);
      navButton?.classList.toggle('cfg-search-hidden', !!term && !paneMatchesSearch);
      if (paneMatchesSearch) matches.push(pane);
    });

    if (!term) {
      openLigaDbButtons.forEach((button) => button.classList.remove('cfg-search-hidden'));
      _settingsSearchActive = false;
      restoreSectionStates();
      setActiveSettingsPane(_settingsSearchReturnPane);
      const returnCard = document.querySelector(`#cfgCard [data-cfg-pane="${_settingsSearchReturnPane}"]`);
      const returnSection = returnCard?.querySelector(`:scope > .cfg-section[data-cfg-section-id="${_settingsSearchReturnSection}"]`)
        || returnCard?.querySelector(':scope > .cfg-section');
      if (returnSection) selectSettingsSection(_settingsSearchReturnPane, returnSection.dataset.cfgSectionId);
      if (status) status.textContent = '';
      return;
    }

    openLigaDbButtons.forEach((button) => {
      button.classList.toggle('cfg-search-hidden', !button.textContent.toLowerCase().includes(term));
    });
    if (status) status.textContent = matches.length ? `${matches.length} Bereiche gefunden` : 'Keine passenden Einstellungen gefunden';
    if (matches.length) {
      const currentPane = document.querySelector('#cfgCard .cfg-nav-btn.active')?.dataset.cfgPaneBtn;
      const activePane = matches.includes(currentPane) ? currentPane : matches[0];
      const activeCard = document.querySelector(`#cfgCard [data-cfg-pane="${activePane}"]`);
      const firstVisibleSection = activeCard?.querySelector(':scope > .cfg-section:not(.cfg-search-hidden)');
      if (firstVisibleSection) selectSettingsSection(activePane, firstVisibleSection.dataset.cfgSectionId);
    }
  }

  async function loadSystemLocalization() {
    const statusEl = document.getElementById('cfgLocaleStatus');
    const btn = document.getElementById('btnLocaleReload');
    if (btn) btn.disabled = true;
    if (statusEl) { statusEl.textContent = 'Lade…'; statusEl.className = 'muted'; }
    try {
      const d = await fetch('/api/system-localization').then(r => r.json());
      if (!d.ok) throw new Error(d.error || 'Laden fehlgeschlagen');
      const tz = document.getElementById('cfgTimezone');
      const dt = document.getElementById('cfgDateTimeLocal');
      const locale = document.getElementById('cfgSystemLocale');
      if (tz) {
        if (Array.isArray(d.timezoneOptions) && d.timezoneOptions.length) {
          const existingValues = new Set(Array.from(tz.options).map(o => o.value));
          d.timezoneOptions.forEach((opt) => {
            if (!opt?.value || existingValues.has(opt.value)) return;
            const o = document.createElement('option');
            o.value = opt.value;
            o.textContent = opt.label || opt.value;
            tz.appendChild(o);
          });
        }
        if (d.timezone && !Array.from(tz.options).some(o => o.value === d.timezone)) {
          const o = document.createElement('option');
          o.value = d.timezone;
          o.textContent = `${d.timezone} (aktuell)`;
          tz.appendChild(o);
        }
        tz.value = d.timezone || '';
      }
      if (dt) dt.value = d.dateTimeLocal || '';
      if (locale) {
        if (Array.isArray(d.localeOptions) && d.localeOptions.length) {
          const existingValues = new Set(Array.from(locale.options).map(o => o.value));
          d.localeOptions.forEach((opt) => {
            if (!opt?.value || existingValues.has(opt.value)) return;
            const o = document.createElement('option');
            o.value = opt.value;
            o.textContent = opt.label || opt.value;
            locale.appendChild(o);
          });
        }
        locale.value = d.systemLocale || '';
      }
      if (statusEl) {
        statusEl.textContent = `Aktuell: ${d.localDate || '-'} ${d.localTime || '-'} | TZ: ${d.timezone || '-'} | Sprache: ${d.systemLocale || '-'}`;
        statusEl.className = 'muted';
      }
    } catch (e) {
      if (statusEl) { statusEl.textContent = 'Fehler: ' + e.message; statusEl.className = 'err'; }
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  async function saveSystemLocalization() {
    const statusEl = document.getElementById('cfgLocaleStatus');
    const btn = document.getElementById('btnLocaleSave');
    const body = {
      timezone: document.getElementById('cfgTimezone')?.value.trim() || '',
      datetimeLocal: document.getElementById('cfgDateTimeLocal')?.value || '',
      systemLocale: document.getElementById('cfgSystemLocale')?.value.trim() || ''
    };
    if (!body.timezone && !body.datetimeLocal && !body.systemLocale) {
      if (statusEl) { statusEl.textContent = 'Keine Werte gesetzt'; statusEl.className = 'warn'; }
      return;
    }

    if (btn) btn.disabled = true;
    if (statusEl) { statusEl.textContent = 'Übernehme Systemeinstellungen…'; statusEl.className = 'muted'; }
    try {
      const d = await fetch('/api/system-localization', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      }).then(r => r.json());

      if (!d.ok) {
        const msg = [d.error, d.hint, d.details].filter(Boolean).join(' | ');
        throw new Error(msg || 'Speichern fehlgeschlagen');
      }
      if (statusEl) { statusEl.textContent = '✓ Übernommen: ' + (d.applied || []).join(', '); statusEl.className = 'ok'; }
      toast('✓ Raspi-Einstellungen übernommen', 'ok');
      loadSystemLocalization();
    } catch (e) {
      if (statusEl) { statusEl.textContent = 'Fehler: ' + e.message; statusEl.className = 'err'; }
      toast('Fehler: ' + e.message, 'err');
    } finally {
      if (btn) btn.disabled = false;
    }
  }

