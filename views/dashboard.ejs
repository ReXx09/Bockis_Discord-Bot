      button.disabled = false;
    }
  }

  async function reloadCommandTileTable() {
    const editor = document.getElementById('cfgCommandTileTemplate');
    const status = document.getElementById('cfgCommandTilePreviewStatus');
    if (!editor || !status) return;
    try {
      const generatedText = await requestCommandTilePreviewText('{{commands}}');
