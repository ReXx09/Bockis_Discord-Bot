  function arEnsureDefaultTemplateRules(rules = []) {
    const arr = Array.isArray(rules) ? rules : [];
    const byId = new Map();
    for (const rule of arr) {
      const id = String(rule?.id || '').trim();
      if (!id) continue;
      byId.set(id, { ...rule, enabled: rule?.enabled !== false });
    }
    for (const tmpl of _arDefaultTemplateRules) {
      if (!byId.has(tmpl.id)) byId.set(tmpl.id, { ...tmpl });
    }
    return Array.from(byId.values());
  }

