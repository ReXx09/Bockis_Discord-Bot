    } else if (configuredShortcut) {
      const option = document.createElement('option');
      option.value = `${configuredShortcut}|${configuredSeason || ''}`;
      option.textContent = `${configuredShortcut} · gespeicherte Liga`;
      leagueSelect.appendChild(option);
      leagueSelect.value = option.value;
    }
    row.querySelector('[data-openliga-role="notification"]').value = feed.notificationChannelId || '';
    row.querySelector('[data-openliga-role="countdown-channel"]').value = feed.countdownChannelId || '';
    row.querySelector('[data-openliga-role="tables"]').value = (feed.tableChannelIds || []).join(',');
    row.querySelector('[data-openliga-role="countdown-team"]').dataset.savedValue = feed.countdownTeamId == null
      ? ''
      : String(feed.countdownTeamId);
    const countdownStyle = [
      'classic', 'compact', 'detailed', 'focus', 'calendar',
      'matchday', 'homeaway', 'minimal', 'competition', 'spotlight',
    ].includes(feed.countdownStyle) ? feed.countdownStyle : 'classic';
    row.querySelector('[data-openliga-role="countdown-style"]').value = countdownStyle;
    const savedUpdateInterval = Number(feed.updateIntervalMinutes);
    row.querySelector('[data-openliga-role="update-interval"]').value = String(
      Number.isInteger(savedUpdateInterval) && savedUpdateInterval >= 1 && savedUpdateInterval <= 60
        ? savedUpdateInterval
        : 1,
    );
    const finishedImage = feed.finishedMatchImage || {};
    row.querySelector('[data-openliga-role="finished-image-enabled"]').checked = finishedImage.enabled === true;
    row.querySelector('[data-openliga-role="finished-image-scorers"]').checked = finishedImage.showScorers !== false;
    row.querySelector('[data-openliga-role="finished-image-competition"]').checked = finishedImage.showCompetition !== false;
    row.querySelector('[data-openliga-role="finished-image-date"]').checked = finishedImage.showDate === true;
    row.querySelector('[data-openliga-role="finished-image-template"]').value = ['stadium', 'classic', 'minimal'].includes(finishedImage.template)
      ? finishedImage.template
      : 'stadium';
    const favoriteTeamIds = Array.isArray(feed.favoriteTeamIds) ? feed.favoriteTeamIds : [];
    const savedMaxFavorites = Number(feed.maxFavorites);
    row.querySelector('[data-openliga-role="max-favorites"]').value = String(
      Number.isInteger(savedMaxFavorites) && savedMaxFavorites >= 1 && savedMaxFavorites <= 40
        ? savedMaxFavorites
        : Math.min(40, Math.max(5, favoriteTeamIds.length)),
    );
    row.querySelector('[data-openliga-role="title"]').textContent = matchingLeague?.leagueName || configuredShortcut;
    leagueSelect.addEventListener('change', async () => {
      const selected = leagues.find(league => `${league.leagueShortcut}|${league.leagueSeason}` === leagueSelect.value);
      row.querySelector('[data-openliga-role="title"]').textContent = selected?.leagueName || leagueSelect.value;
      refreshOpenLigaDbNavigation();
      await loadOpenLigaDbTeams(row);
    });
    row.querySelector('[data-openliga-role="remove"]').addEventListener('click', () => {
      const previewImage = row.querySelector('[data-openliga-role="finished-image-preview-image"]');
      if (previewImage.dataset.objectUrl) URL.revokeObjectURL(previewImage.dataset.objectUrl);
      row.remove();
      refreshOpenLigaDbNavigation();
      updateOpenLigaDbFeedVisibility();
      syncOpenLigaDbFeedsDirtyState();
    });
    row.querySelector('[data-openliga-role="favorites"]').addEventListener('change', () => updateOpenLigaDbFavoriteSelection(row));
    row.querySelector('[data-openliga-role="max-favorites"]').addEventListener('change', event => {
      const input = event.currentTarget;
      input.value = String(getOpenLigaDbFavoriteLimit(row));
      updateOpenLigaDbFavoriteSelection(row, true);
    });
    row.querySelector('[data-openliga-role="countdown-preview-button"]').addEventListener('click', () => {
      renderOpenLigaDbCountdownPreview(row);
    });
    row.querySelector('[data-openliga-role="countdown-team"]').addEventListener('change', () => {
      const preview = row.querySelector('[data-openliga-role="countdown-preview"]');
      if (!row.querySelector('[data-openliga-role="countdown-team"]').value) preview.hidden = true;
      else if (!preview.hidden) void renderOpenLigaDbCountdownPreview(row);
    });
    row.querySelector('[data-openliga-role="countdown-style"]').addEventListener('change', () => {
      if (!row.querySelector('[data-openliga-role="countdown-preview"]').hidden) {
        void renderOpenLigaDbCountdownPreview(row);
      }
    });
    row.querySelector('[data-openliga-role="finished-image-preview"]').addEventListener('click', () => {
      void previewOpenLigaDbFinishedImage(row);
    });
    row.querySelector('[data-openliga-role="finished-image-test"]').addEventListener('click', () => {
      void sendOpenLigaDbFinishedImageTest(row);
    });
    for (const role of ['finished-image-scorers', 'finished-image-competition', 'finished-image-date', 'finished-image-template']) {
      row.querySelector(`[data-openliga-role="${role}"]`).addEventListener('change', () => {
        if (!row.querySelector('[data-openliga-role="finished-image-preview-image"]').hidden) {
          void previewOpenLigaDbFinishedImage(row);
        }
      });
    }
    await loadOpenLigaDbTeams(row, favoriteTeamIds);
    refreshOpenLigaDbNavigation();
    updateOpenLigaDbFeedVisibility();
    syncOpenLigaDbFeedsDirtyState();
    if (selectAfterAdd) selectOpenLigaDbFeed(row.dataset.openligaFeedId);
  }

  function getOpenLigaDbFinishedImageSettings(row) {
    return {
      showScorers: row.querySelector('[data-openliga-role="finished-image-scorers"]').checked,
      showCompetition: row.querySelector('[data-openliga-role="finished-image-competition"]').checked,
      showDate: row.querySelector('[data-openliga-role="finished-image-date"]').checked,
      template: row.querySelector('[data-openliga-role="finished-image-template"]').value,
    };
  }

  async function previewOpenLigaDbFinishedImage(row) {
    const status = row.querySelector('[data-openliga-role="finished-image-status"]');
    const image = row.querySelector('[data-openliga-role="finished-image-preview-image"]');
    status.textContent = 'Vorschau wird erstellt …';
    status.className = 'cfg-hint';
    try {
      const response = await fetch('/api/openligadb/finished-match-preview.png', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ settings: getOpenLigaDbFinishedImageSettings(row) }),
      });
      if (!response.ok) {
        const result = await response.json();
        throw new Error(result.error || 'Vorschau konnte nicht erstellt werden.');
      }
      if (image.dataset.objectUrl) URL.revokeObjectURL(image.dataset.objectUrl);
      image.dataset.objectUrl = URL.createObjectURL(await response.blob());
      image.src = image.dataset.objectUrl;
      image.hidden = false;
      status.textContent = 'Vorschau mit Beispieldaten. Änderungen an den Grafikoptionen aktualisieren sie.';
    } catch (error) {
      status.textContent = error.message;
      status.className = 'cfg-hint err';
    }
  }

  async function sendOpenLigaDbFinishedImageTest(row) {
    const status = row.querySelector('[data-openliga-role="finished-image-status"]');
    const button = row.querySelector('[data-openliga-role="finished-image-test"]');
    const channelId = row.querySelector('[data-openliga-role="notification"]').value.trim();
    if (!activeServerProfileGuildId || !channelId) {
      status.textContent = 'Bitte zuerst einen Server und den Kanal für Tor- und Spielmeldungen auswählen.';
      status.className = 'cfg-hint err';
      return;
    }
    button.disabled = true;
    status.textContent = 'Testgrafik wird an Discord gesendet …';
    status.className = 'cfg-hint';
    try {
      const response = await fetch('/api/openligadb/finished-match-test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          guildId: activeServerProfileGuildId,
          channelId,
          settings: getOpenLigaDbFinishedImageSettings(row),
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'Testgrafik konnte nicht gesendet werden.');
      status.textContent = result.message || 'Testgrafik wurde gesendet.';
      status.className = 'cfg-hint ok';
    } catch (error) {
      status.textContent = error.message;
      status.className = 'cfg-hint err';
    } finally {
      button.disabled = false;
    }
  }

  function serializeOpenLigaDbFeeds() {
    return Array.from(document.querySelectorAll('#cfgOpenLigaDbFeeds [data-openliga-feed]')).map(row => {
      const [leagueShortcut, season] = row.querySelector('[data-openliga-role="league"]').value.split('|');
      return {
        leagueShortcut,
        season: Number(season) || undefined,
        updateIntervalMinutes: Number(row.querySelector('[data-openliga-role="update-interval"]').value),
        finishedMatchImage: {
          enabled: row.querySelector('[data-openliga-role="finished-image-enabled"]').checked,
          showScorers: row.querySelector('[data-openliga-role="finished-image-scorers"]').checked,
          showCompetition: row.querySelector('[data-openliga-role="finished-image-competition"]').checked,
          showDate: row.querySelector('[data-openliga-role="finished-image-date"]').checked,
          template: row.querySelector('[data-openliga-role="finished-image-template"]').value,
        },
        maxFavorites: getOpenLigaDbFavoriteLimit(row),
        favoriteTeamIds: Array.from(row.querySelectorAll('[data-openliga-role="favorites"] input[type="checkbox"]:checked'), checkbox => Number(checkbox.value)).filter(Number.isInteger),
        countdownTeamId: row.querySelector('[data-openliga-role="countdown-team"]').value || null,
        countdownStyle: row.querySelector('[data-openliga-role="countdown-style"]').value,
        countdownChannelId: row.querySelector('[data-openliga-role="countdown-channel"]').value.trim(),
        notificationChannelId: row.querySelector('[data-openliga-role="notification"]').value.trim(),
        tableChannelIds: [...new Set(row.querySelector('[data-openliga-role="tables"]').value.split(/[;,]/).map(id => id.trim()).filter(Boolean))],
      };
    }).filter(feed => feed.leagueShortcut);
  }

  function syncOpenLigaDbFeedsDirtyState() {
    const field = document.getElementById('cfgOpenLigaDbFeedsValue');
    if (!field) return;
    field.value = JSON.stringify(serializeOpenLigaDbFeeds());
    _setDirtyState(field, _isFieldDirty(field));
    refreshConfigDirtyIndicator();
  }

  function markOpenLigaDbSettingsSaved() {
    const enabled = document.getElementById('cfgOpenLigaDbEnabled');
    if (enabled) {
      enabled.dataset.initialValue = enabled.checked ? 'true' : 'false';
      _setDirtyState(enabled, false);
    }
    document.querySelectorAll('#cfgOpenLigaDbFeeds input, #cfgOpenLigaDbFeeds select, #cfgOpenLigaDbFeeds textarea').forEach((input) => {
      input.dataset.initialValue = input.type === 'checkbox' ? (input.checked ? 'true' : 'false') : String(input.value ?? '');
      _setDirtyState(input, false);
    });
    const serialized = JSON.stringify(serializeOpenLigaDbFeeds());
    const container = document.getElementById('cfgOpenLigaDbFeeds');
    const field = document.getElementById('cfgOpenLigaDbFeedsValue');
    container.dataset.initialValue = serialized;
    field.value = serialized;
    field.dataset.initialValue = serialized;
    _setDirtyState(field, false);
    refreshConfigDirtyIndicator();
  }

  async function loadOpenLigaDbSettings(configData) {
    const container = document.getElementById('cfgOpenLigaDbFeeds');
    const status = document.getElementById('cfgOpenLigaDbStatus');
    container.replaceChildren();
    activeOpenLigaDbFeedId = '';
    refreshOpenLigaDbNavigation();
    updateOpenLigaDbFeedVisibility();
    let feeds = [];
    let hasExplicitFeedConfig = false;
    if (configData.DISCORD_OPENLIGADB_FEEDS) {
      try {
        feeds = JSON.parse(configData.DISCORD_OPENLIGADB_FEEDS);
        hasExplicitFeedConfig = Array.isArray(feeds);
      } catch {}
    }
    if (!hasExplicitFeedConfig && (!Array.isArray(feeds) || !feeds.length)) {
      if ((configData.DISCORD_OPENLIGADB_ENABLED || 'false') === 'true') {
        feeds = [{
          leagueShortcut: 'bl1',
          favoriteTeamIds: String(configData.DISCORD_OPENLIGADB_FAVORITES || '').split(/[;,]/).map(Number).filter(id => Number.isInteger(id) && id > 0),
          notificationChannelId: configData.DISCORD_OPENLIGADB_CHANNEL_ID || '',
          tableChannelIds: [],
        }];
      }
    }
    try {
      const leagues = await ensureOpenLigaDbLeagues();
      populateOpenLigaDbAddLeagueOptions(leagues);
      const currentShortcuts = new Set(leagues.map(league => league.leagueShortcut));
      const configuredFeedCount = feeds.length;
      feeds = feeds.filter(feed => currentShortcuts.has(feed.leagueShortcut));
      const outdatedFeedCount = configuredFeedCount - feeds.length;
      status.textContent = `${leagues.length} aktuelle Fußballligen verfügbar${outdatedFeedCount ? ` · ${outdatedFeedCount} veraltete Feeds ausgeblendet` : ''}`;
      status.className = 'cfg-hint';
    } catch (error) {
      populateOpenLigaDbAddLeagueOptions([]);
      status.textContent = error.message;
      status.className = 'cfg-hint err';
    }
    for (const feed of feeds) await addOpenLigaDbFeed(feed);
    const initialValue = JSON.stringify(serializeOpenLigaDbFeeds());
    container.dataset.initialValue = initialValue;
    const field = document.getElementById('cfgOpenLigaDbFeedsValue');
    field.value = initialValue;
    field.dataset.initialValue = initialValue;
    _setDirtyState(field, false);
    refreshOpenLigaDbNavigation();
    updateOpenLigaDbFeedVisibility();
  }

  async function loadConfig({ force = false } = {}) {
    try {
      const configUrl = activeServerProfileGuildId
        ? `/api/config?guildId=${encodeURIComponent(activeServerProfileGuildId)}`
        : '/api/config';
      const d = await fetch(configUrl).then(r => r.json());
      if (!d.ok) { document.getElementById('cfgStatus').textContent = d.error; return; }

      const setCfg = (id, value) => setFieldValue(id, value, { force });
