  async function saveCommandTileTemplate() {
    const editor = document.getElementById('cfgCommandTileTemplate');
    const status = document.getElementById('cfgCommandTilePreviewStatus');
    const button = document.getElementById('btnCommandTileSave');
    if (!editor || !status || !button) return;
    button.disabled = true;
    status.textContent = 'Vorlage wird gespeichert…';
    try {
      const template = editor.value === editor.dataset.generatedValue ? '{{commands}}' : editor.value;
      const response = await fetch('/api/command-tile/template', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ template })
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'Vorlage konnte nicht gespeichert werden');
      editor.dataset.initialValue = editor.value;
      status.textContent = result.message || 'Vorlage gespeichert.';
      toast('Vorlage gespeichert', 'ok');
    } catch (err) {
      status.textContent = err.message;
      toast(err.message, 'error');
