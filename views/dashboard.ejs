      const savedCommandTileTemplate = d.DISCORD_COMMAND_TILE_TEMPLATE || '{{commands}}';
      const commandTileTemplateIsDynamic = savedCommandTileTemplate.includes('{{commands}}');
      const commandTileEditorValue = commandTileTemplateIsDynamic
