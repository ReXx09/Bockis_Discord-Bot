        ]);
        const settings = Object.fromEntries(Object.entries(body).filter(([key]) => profileKeys.has(key)));
        if (Object.hasOwn(body, 'DISCORD_COMMAND_TILE_TEMPLATE')) {
          const bytes = new TextEncoder().encode(body.DISCORD_COMMAND_TILE_TEMPLATE);
